---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageDevotional from './HomepageDevotional.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import SongPlayer from './SongPlayer.astro';
import AudioPlayer from './AudioPlayer.astro';
import LandingSections from './home/LandingSections.astro';
import { useTranslations } from '../i18n/utils';
import { TEXT_LANGUAGES } from '../data/textLanguages';

const pericopeModules = import.meta.glob('../content/luke-1-pericopes-*.json', { eager: true });

interface Props { lang: string }

const { lang } = Astro.props;

const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

// Pick whatever morning + evening devotional this language has wired on Luke 1.
// Different languages have their single reflexionen on different pericopes
// (verkuendigung / magnificat / annunciation / benedictus / ...), so walk the
// pericopes array and grab the first entry of each kind.
type DevotionalEntry = { title: string; mp3: string; duration?: string };
const pericopeData = (pericopeModules[`../content/luke-1-pericopes-${lang}.json`] as any)?.default;
let morningDevotional: DevotionalEntry | null = null;
let eveningDevotional: DevotionalEntry | null = null;
if (pericopeData?.pericopes) {
  for (const p of pericopeData.pericopes) {
    const m = p?.media || {};
    if (!morningDevotional && m.devotional?.mp3) morningDevotional = m.devotional;
    if (!eveningDevotional && m.reflexionen?.mp3) eveningDevotional = m.reflexionen;
    if (morningDevotional && eveningDevotional) break;
  }
}

// Non-text languages (textLanguages.ts): no reading pages exist, so the
// homepage carries the media that IS ready — songs and podcasts per pericope.
// The audio Bible is deliberately excluded: it is the unreviewed translation
// read aloud, which is exactly what the text gate keeps private.
const isTextLang = TEXT_LANGUAGES.includes(lang);
type Song = { title: string; mp3: string; genre?: string; description?: string; coverArt?: string; duration?: string };
const homeSongs: Song[] = [];
const homePodcasts: Array<{ title: string; src: string; subtitle?: string }> = [];
if (!isTextLang && pericopeData?.pericopes) {
  for (const p of pericopeData.pericopes) {
    const m = p?.media || {};
    const songs: Song[] = m.songs || (m.song ? [m.song] : []);
    for (const s of songs) if (s?.mp3) homeSongs.push(s);
    if (m.podcast?.mp3) {
      homePodcasts.push({
        title: p.title || m.podcast.title,
        src: `/audio/podcasts/${m.podcast.mp3}`,
        subtitle: m.podcast.duration,
      });
    }
  }
}

---

<BaseLayout title={t('home.pageTitle')} lang={lang} heroPage={true}>
  <!-- Video Hero -->
  <section class="video-hero">
    <!-- Background video -->
    <video
      class="video-bg"
      id="hero-video"
      poster={`${base}images/homepage_hero_sunrise_low.png`}
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <!-- Color overlay -->
    <div class="video-overlay" aria-hidden="true"></div>
    <!-- Grain overlay -->
    <div class="video-grain" aria-hidden="true" style={`background-image: url(${base}images/grain.gif)`}></div>
    <!-- Content -->
    <div class="video-hero-content">
      <h1 class="hero-wordmark tracking-tight logo">aperto</h1>
      {isTextLang ? (
        <Fragment>
          <p class="hero-lead">{t('home.landing.heroLead')}</p>
          <p class="hero-tagline">{t('home.landing.heroSub')}</p>
        </Fragment>
      ) : (
        <p class="hero-tagline">
          {t('home.tagline')}
        </p>
      )}
      <p class="hero-ai-clause">{t('home.aiClause')}</p>
      <div class="flex justify-center items-center flex-wrap gap-3">
        {isTextLang ? (
          <Fragment>
            <a href="#first-passage" class="hero-btn hero-btn-primary">{t('home.landing.ctaRead')}</a>
            <a href="#listen" class="hero-btn">{t('home.landing.ctaListen')}</a>
          </Fragment>
        ) : (
          <a href="#listen" class="hero-btn">
            {t('home.media.heroCta')}
          </a>
        )}
      </div>
    </div>
  </section>

  <script define:vars={{ base }}>
    (function () {
      var v = document.getElementById('hero-video');
      if (!v) return;
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      function apply() {
        var dark = mq.matches;
        var next = base + 'videos/' + (dark ? 'hero-dark.mp4' : 'hero-light.mp4');
        if (v.getAttribute('src') === next) return;
        v.setAttribute('poster', base + 'images/' + (dark ? 'homepage_hero_blue_hour_low.png' : 'homepage_hero_sunrise_low.png'));
        v.setAttribute('src', next);
        v.load();
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      }
      apply();
      if (mq.addEventListener) mq.addEventListener('change', apply);
      else if (mq.addListener) mq.addListener(apply);
    })();
  </script>

  <style>
    /* Prevent blurred video from bleeding horizontally */
    :global(body) {
      overflow-x: hidden;
    }

    /* Video Hero */
    .video-hero {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      clip-path: inset(0);
    }

    /* Bottom fade only — left/right stay clean */
    .video-hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 50%, #FFFBF5 100%);
      z-index: 4;
      pointer-events: none;
    }

    /* Bulletproof fullscreen video: 130% size, centered via translate.
       The 15% overhang on every side hides the blur's transparent fringe
       (blur radius ≈ 3× the 30px sigma) outside the parent's overflow clip.
       Avoids over-constrained left/right/width absolute-positioning quirks. */
    .video-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 130%;
      height: 130%;
      transform: translate(-50%, -50%);
      object-fit: cover;
      object-position: center center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
    }

    .video-overlay {
      position: absolute;
      inset: 0;
      /* Light mode: light at the edges (sunrise shows through), soft scrim
         only behind the centered wordmark so the cream text stays legible. */
      background: radial-gradient(ellipse 78% 68% at 50% 44%, rgba(18, 11, 5, 0.42) 0%, rgba(34, 20, 10, 0.13) 60%, rgba(34, 20, 10, 0.04) 100%);
      z-index: 1;
    }

    .video-grain {
      position: absolute;
      inset: 0;
      opacity: 0.09;
      background-repeat: repeat;
      background-size: 128px auto;
      z-index: 2;
    }

    .video-hero-content {
      position: relative;
      /* Above the bottom fade (::after, z 4), which otherwise washes out the CTAs */
      z-index: 5;
      text-align: center;
      padding: 2rem;
      max-width: 56rem;
      margin: 0 auto;
    }

    .hero-wordmark {
      font-size: clamp(5rem, 16vw, 14rem);
      line-height: 1;
      color: #FFFBF5;
      margin-bottom: 1.5rem;
      text-shadow: 0 2px 32px rgba(0,0,0,0.25);
    }

    .hero-lead {
      font-family: var(--font-headline);
      font-size: clamp(1.5rem, 3.6vw, 2.4rem);
      line-height: 1.25;
      color: #FFFBF5;
      max-width: 40rem;
      margin: 0 auto 1rem;
      text-shadow: 0 2px 24px rgba(0,0,0,0.25);
    }

    .hero-btn.hero-btn-primary {
      background-color: #FFFBF5;
      color: #2C2C2C;
      border-color: #FFFBF5;
    }

    .hero-btn.hero-btn-primary:hover {
      background-color: #FFFFFF;
      color: #2C2C2C;
    }

    .hero-tagline {
      font-size: clamp(1rem, 2.2vw, 1.4rem);
      line-height: 1.6;
      color: rgba(255, 251, 245, 0.82);
      max-width: 36rem;
      margin: 0 auto 1.25rem;
      font-weight: 300;
    }

    .hero-ai-clause {
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 251, 245, 0.6);
      margin: 0 auto 2.25rem;
      font-weight: 400;
    }

    /* Lighter Switzer for body copy on the homepage.
       Switzer ships 150 (Regular) + 500 (Medium); 300 rounds to 150. */
    section p {
      font-weight: 300;
    }

    .hero-btn {
      display: inline-block;
      padding: 0.9rem 2.2rem;
      border-radius: 6px;
      font-weight: 500;
      background-color: rgba(30, 20, 10, 0.32);
      color: #FFFBF5;
      border: 1px solid rgba(255, 251, 245, 0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: background-color 0.2s, border-color 0.2s;
      text-decoration: none;
    }

    .hero-btn:hover {
      background-color: rgba(30, 20, 10, 0.45);
      border-color: rgba(255, 251, 245, 0.55);
    }

    .video-hero::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 130%;
      height: 130%;
      transform: translate(-50%, -50%);
      background-image: url('/images/homepage_hero_sunrise_low.png');
      background-size: cover;
      background-position: center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
      opacity: 0;
      transition: opacity 0.3s;
    }

    @media (prefers-reduced-motion: reduce) {
      .video-bg { display: none; }
      .video-hero::before { opacity: 1; }
    }

    /* Dark mode: reduced-motion fallback still shows the blue-hour still */
    @media (prefers-color-scheme: dark) {
      .video-hero::before { background-image: url('/images/homepage_hero_blue_hour_low.png'); }
      /* Richer, cooler wash for the blue-hour video. */
      .video-overlay {
        background: radial-gradient(ellipse 85% 72% at 50% 44%, rgba(6, 9, 18, 0.55) 0%, rgba(10, 14, 26, 0.34) 70%, rgba(10, 14, 26, 0.22) 100%);
      }
    }

    /* Get Involved section */
    .get-involved-section {
      background-color: var(--color-charcoal);
      color: var(--color-cream);
    }

    .get-involved-section h2 {
      color: var(--color-cream);
    }

    .get-involved-section p {
      color: rgba(255, 251, 245, 0.7);
    }

    .get-involved-btn {
      background-color: var(--color-cream);
      color: var(--color-charcoal);
    }

    @media (prefers-color-scheme: dark) {
      .get-involved-section {
        background-color: #111111;
        color: #f0ebe3;
      }

      .get-involved-section h2 {
        color: #f0ebe3;
      }

      .get-involved-section p {
        color: rgba(240, 235, 227, 0.65);
      }

      .get-involved-btn {
        background-color: #f0ebe3;
        color: #111111;
      }
    }
  </style>

  {isTextLang ? (
    <LandingSections lang={lang} base={base} morning={morningDevotional} evening={eveningDevotional} />
  ) : (
  <Fragment>
  <HomepageDevotional lang={lang} morning={morningDevotional} evening={eveningDevotional} />

  <section class="py-24 px-8 md:px-16 lg:px-24" style="background-color: rgba(245, 230, 220, 0.3);">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl mb-12 text-center headline-mixed">{t('home.differentBible')}</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.accessible')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.accessibleDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.multimedia')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.multimediaDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.openSource')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.openSourceDesc')}
          </p>
        </div>
      </div>
      <p class="text-center text-lg mt-12 max-w-2xl mx-auto" style="color: #6A6A6A; font-style: italic;">
        {t('home.honestNotes')}
      </p>
    </div>
  </section>

  {/* Non-text languages: listen-only (songs + podcasts); their translation
       text has not passed the quality gates yet. */}
    <section id="listen" class="py-24 px-8 md:px-16 lg:px-24">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl mb-4 headline-mixed">{t('home.media.title')}</h2>
          <p class="text-lg leading-relaxed max-w-2xl mx-auto" style="color: #6A6A6A;">
            {t('home.media.inProgress')}
          </p>
        </div>
        {homeSongs.length > 0 && (
          <div class="space-y-6 mb-12">
            {homeSongs.map((song) => (
              <SongPlayer song={song} lang={lang} />
            ))}
          </div>
        )}
        {homePodcasts.length > 0 && (
          <div class="space-y-4">
            <h3 class="text-xl mb-4">{t('reader.podcast')}</h3>
            {homePodcasts.map((p) => (
              <AudioPlayer title={p.title} src={p.src} subtitle={p.subtitle} />
            ))}
          </div>
        )}
      </div>
    </section>
  </Fragment>
  )}

  <NewsletterSignup lang={lang} />

  <!-- Get Involved -->
  <section class="get-involved-section py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-6">{t('home.getInvolved.title')}</h2>
      <p class="text-lg leading-relaxed mb-10">
        {t('home.getInvolved.description')}
      </p>
      <button
        class="get-involved-btn px-8 py-4 rounded font-medium transition-all hover:opacity-90 cursor-pointer"
      >
        {t('home.getInvolved.button')}
      </button>
    </div>
  </section>

  <script is:inline>
    document.querySelector('.get-involved-btn')?.addEventListener('click', function() {
      if (typeof Tally !== 'undefined') {
        Tally.openPopup('b58vj1', { width: 600 });
      } else {
        window.open('https://tally.so/r/b58vj1', '_blank');
      }
    });
  </script>
</BaseLayout>
