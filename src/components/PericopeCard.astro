---
import { marked } from 'marked';
import SongPlayer from './SongPlayer.astro';

interface Song {
  description?: string;
  title: string;
  mp3: string;
  genre: string;
  transcriptPath?: string;
}

interface Footnote {
  ref: string;
  category: string;
  keyword: string;
  content: string;
}

interface Props {
  id: string;
  title: string;
  subtitle: string;
  verses: string;
  color?: string;
  accentColor?: string;
  image?: string;
  verseData: any[];
  media: {
    practice?: { title: string; verseRef: string; content?: string };
    song?: { title: string; mp3: string };
    songs?: Song[];
    podcast?: { title: string; duration?: string; description?: string; scriptFile?: string; mp3?: string };
    audioBible?: { title: string; mp3: string; transcriptPath?: string };
    devotional?: { title: string; mp3: string; duration?: string };
    spiritualPractice?: { title: string; mp3: string; duration?: string };
  };
  exegesis?: {
    section: string;
    label: string;
  };
  lang: string;
  chapter?: number;
  isFirst?: boolean;
  layoutIndex?: number;
  audioBibleStart?: number;
  audioBibleMp3?: string;
  audioBibleTranscriptPath?: string;
}

const { id, title, subtitle, verses, image, verseData, media, exegesis, lang, chapter = 1, isFirst, layoutIndex = 0, audioBibleStart, audioBibleMp3, audioBibleTranscriptPath } = Astro.props;

// Determine if audiobible has karaoke capability
const audioBibleHasTranscript = !!(audioBibleTranscriptPath || media.audioBible?.transcriptPath);
const resolvedAudioBibleTranscriptPath = audioBibleTranscriptPath || media.audioBible?.transcriptPath;

// Audiobible playback ID for this pericope
const audioBiblePlayerId = `audiobible-player-${id}`;

// Parse practice content from markdown to HTML
const practiceContentHtml = media.practice?.content ? marked.parse(media.practice.content) : '';
const base = '';

// Determine the exegesis URL based on language availability
// New languages have localized exegesis, others fall back to English
const localizedExegesisLangs = ['da', 'es', 'it', 'pt', 'sv', 'uk'];
const exegesisBasePath = localizedExegesisLangs.includes(lang)
  ? `${base}/${lang}/exegesis/luke/${chapter}`
  : `${base}/exegesis/luke/${chapter}`;

const songs: Song[] = media.songs || (media.song ? [{ ...media.song, genre: '' }] : []);
const hasMedia = media.practice || songs.length > 0 || media.podcast || exegesis || media.audioBible;

function formatTitle(text: string): string {
  return text.split('').map(char => {
    if (/[A-Z]/.test(char)) {
      return '<span class="cap">' + char + '</span>';
    }
    return char;
  }).join('');
}

// Collect all footnotes for mobile view
const allFootnotes: (Footnote & { verseNum: number; verseIdx: number; fnIdx: number })[] = [];
verseData.forEach((verse, idx) => {
  verse.footnotes.forEach((fn: Footnote, fnIdx: number) => {
    allFootnotes.push({ ...fn, verseNum: verse.number, verseIdx: idx, fnIdx });
  });
});

// Group verses into poetry blocks and prose sections
type VerseGroup = { type: 'prose' | 'poetry'; verses: { verse: any; idx: number }[] };
const verseGroups: VerseGroup[] = [];
let currentGroup: VerseGroup | null = null;

verseData.forEach((verse, idx) => {
  const type = verse.isPoetry ? 'poetry' : 'prose';
  if (!currentGroup || currentGroup.type !== type) {
    currentGroup = { type, verses: [] };
    verseGroups.push(currentGroup);
  }
  currentGroup.verses.push({ verse, idx });
});

const practiceModalId = `practice-modal-${id}`;
const podcastModalId = `podcast-modal-${id}`;

// Category icons
const categoryIcons: Record<string, string> = {
  text: 'translate',
  kultur: 'public', culture: 'public',
  leben: 'favorite', life: 'favorite',
  kontext: 'link', context: 'link',
  unglaublich: 'help', hard: 'help'
};

// Category labels (for display)
const categoryLabels: Record<string, string> = {
  text: 'Text',
  kultur: 'Kultur', culture: 'Culture',
  leben: 'Leben', life: 'Life',
  kontext: 'Kontext', context: 'Context',
  unglaublich: 'Schwierig', hard: 'Difficult'
};

// Process verse text to add inline footnote tooltips
function processVerseWithFootnotes(text: string, footnotes: Footnote[]): { html: string; unmatchedFootnotes: Footnote[] } {
  if (!footnotes || footnotes.length === 0) {
    return { html: text, unmatchedFootnotes: [] };
  }

  let processed = text;
  const matched = new Set<number>();

  footnotes.forEach((fn, idx) => {
    // Extract base keyword (before parentheses for Greek terms like "Theophilus (Θεόφιλος)")
    const baseKeyword = fn.keyword.split('(')[0].trim();

    // Skip if keyword is empty or too short
    if (!baseKeyword || baseKeyword.length < 2) return;

    // Check if keyword exists in text (case-insensitive search, but preserve original case)
    const keywordRegex = new RegExp(`(?<![\\w-])${baseKeyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\w-])`, 'i');
    const match = processed.match(keywordRegex);

    if (match) {
      const originalKeyword = match[0];
      const category = fn.category.toLowerCase();
      const categoryLabel = categoryLabels[category] || fn.category;
      const icon = categoryIcons[category] || 'info';

      // Escape HTML in content to prevent XSS
      const escapedContent = fn.content
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
      const escapedKeyword = fn.keyword
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

      // Create tooltip wrapper
      const replacement = `<span class="footnote-inline" tabindex="0"><span class="footnote-trigger">${originalKeyword}</span><span class="footnote-tooltip"><span class="footnote-tooltip-header"><span class="material-symbols-rounded footnote-tooltip-icon">${icon}</span><span class="footnote-tooltip-category footnote-category-${category}">${categoryLabel}</span></span><span class="footnote-tooltip-keyword">${escapedKeyword}</span><span class="footnote-tooltip-content">${escapedContent}</span></span></span>`;

      // Replace first occurrence only
      processed = processed.replace(keywordRegex, replacement);
      matched.add(idx);
    }
  });

  // Collect unmatched footnotes for additional notes section
  const unmatchedFootnotes = footnotes.filter((_, idx) => !matched.has(idx));

  return { html: processed, unmatchedFootnotes };
}

// Process all verses and collect unmatched footnotes
const processedVerses = verseData.map((verse) => {
  const result = processVerseWithFootnotes(verse.text, verse.footnotes || []);
  return {
    ...verse,
    processedText: result.html,
    unmatchedFootnotes: result.unmatchedFootnotes
  };
});

// Collect all unmatched footnotes for "Additional Notes" section
const additionalNotes: (Footnote & { verseNum: number })[] = [];
processedVerses.forEach((verse) => {
  verse.unmatchedFootnotes.forEach((fn: Footnote) => {
    additionalNotes.push({ ...fn, verseNum: verse.number });
  });
});

// Update verse groups to use processed verses
const processedVerseGroups: VerseGroup[] = [];
let currentProcessedGroup: VerseGroup | null = null;

processedVerses.forEach((verse, idx) => {
  const type = verse.isPoetry ? 'poetry' : 'prose';
  if (!currentProcessedGroup || currentProcessedGroup.type !== type) {
    currentProcessedGroup = { type, verses: [] };
    processedVerseGroups.push(currentProcessedGroup);
  }
  currentProcessedGroup.verses.push({ verse, idx });
});
---

<section class="pericope-card py-16 md:py-24" id={id}>
  <div class="editorial-container max-w-6xl mx-auto px-6 md:px-12">

    <!-- Header -->
    <header class="editorial-header mb-6 max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="passage-reference mb-2">
            {lang === 'de' ? 'Lukas' : 'Luke'} {verses}
          </p>
          <h2 class="headline-mixed text-3xl md:text-4xl lg:text-5xl leading-[1.1]" set:html={formatTitle(title)} />
        </div>
        {audioBibleStart !== undefined && audioBibleMp3 && (
          <button
            class={`audiobible-play-btn flex-shrink-0 ${audioBibleHasTranscript ? 'has-karaoke' : ''}`}
            data-player-id={audioBiblePlayerId}
            data-mp3={`/audio/audiobible/${audioBibleMp3}`}
            data-start-ms={audioBibleStart}
            data-pericope-id={id}
            data-title={media.audioBible?.title || (lang === 'de' ? 'Hörbibel' : 'Audio Bible')}
            data-transcript={audioBibleHasTranscript ? resolvedAudioBibleTranscriptPath : ''}
            data-has-karaoke={audioBibleHasTranscript ? 'true' : 'false'}
            type="button"
            aria-label={lang === 'de' ? 'Hörbibel abspielen' : 'Play Audio Bible'}
            title={lang === 'de' ? 'Hörbibel abspielen' : 'Play Audio Bible'}
          >
            <span class="material-symbols-rounded">play_circle</span>
          </button>
        )}
      </div>
    </header>

    <!-- Image - offset to left, aligned with text end -->
    {image && (
      <figure class="editorial-image mb-10">
        <img
          src={`${base}/images/luke/1/${image}`}
          alt={title}
          class="w-full aspect-video object-cover rounded"
          loading="lazy"
        />
      </figure>
    )}

    <!-- Verses - grouped by prose/poetry with inline footnotes -->
    <div class="verses-container max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%]">
      {processedVerseGroups.map((group) => (
        group.type === 'poetry' ? (
          <div class="poetry-block">
            {group.verses.map(({ verse, idx }) => (
              <div class="poetry-verse">
                <span class="verse-text" set:html={verse.processedText} />
              </div>
            ))}
          </div>
        ) : (
          <div class="prose-section">
            {group.verses.map(({ verse, idx }) => (
              <span class="prose-verse">
                <span class="verse-text" set:html={verse.processedText} />
              </span>
            ))}
          </div>
        )
      ))}
    </div>

    <!-- Additional Notes (for footnotes that couldn't be matched inline) -->
    {additionalNotes.length > 0 && (
      <div class="additional-notes max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%] mt-8 pt-4 border-t" style="border-color: var(--color-border)">
        <p class="text-xs tracking-wider uppercase mb-3" style="color: var(--color-text-muted)">
          {lang === 'de' ? 'Weitere Hinweise' : 'Additional Notes'}
        </p>
        <ul class="space-y-2">
          {additionalNotes.map((fn) => (
            <li class="footnote-item">
              <details class="footnote-details">
                <summary class="footnote-summary flex items-center gap-3 cursor-pointer">
                  <div class="footnote-icon flex-shrink-0 w-7 h-7 rounded-lg flex items-center justify-center" style="background: var(--color-beige)">
                    <span class="material-symbols-rounded text-sm" style="color: var(--color-accent)">
                      {categoryIcons[fn.category.toLowerCase()] || 'info'}
                    </span>
                  </div>
                  <span class="footnote-category uppercase tracking-wider text-[10px] font-medium" style="color: var(--color-text-muted)">
                    {categoryLabels[fn.category.toLowerCase()] || fn.category}
                  </span>
                  <span class="footnote-keyword font-medium text-sm" style="color: var(--color-accent)">{fn.keyword}</span>
                  <span class="footnote-chevron material-symbols-rounded text-sm ml-auto" style="color: var(--color-text-muted)">expand_more</span>
                </summary>
                <div class="footnote-content pl-10 pt-2 pb-1">
                  <p class="footnote-text text-sm leading-relaxed" style="color: var(--color-text)">{fn.content}</p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Media Section -->
    {hasMedia && (
      <div class="media-section max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%] mt-16">
        <div class="media-grid grid grid-cols-1 sm:grid-cols-2 gap-4">

          {media.audioBible && (
            <div class="media-card media-card-audio group">
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper">
                    <span class="material-symbols-rounded text-xl">auto_stories</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{lang === 'de' ? 'Audiobibel' : 'Audio Bible'}</span>
                    <span class="media-card-title">{media.audioBible.title}</span>
                  </div>
                </div>
                {audioBibleHasTranscript ? (
                  <button
                    class="audiobible-karaoke-btn"
                    data-mp3={`/audio/audiobible/${media.audioBible.mp3}`}
                    data-title={media.audioBible.title}
                    data-transcript={resolvedAudioBibleTranscriptPath}
                    data-start-ms={audioBibleStart || 0}
                    type="button"
                  >
                    <span class="material-symbols-rounded">play_arrow</span>
                  </button>
                ) : (
                  <audio controls class="w-full h-10 mt-3" preload="none">
                    <source src={`${base}/audio/audiobible/${media.audioBible.mp3}`} type="audio/mpeg" />
                  </audio>
                )}
              </div>
            </div>
          )}

          {media.practice && (
            <button
              class="media-card media-card-practice group"
              onclick={`document.getElementById('${practiceModalId}').showModal()`}
              type="button"
            >
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-practice">
                    <span class="material-symbols-rounded text-xl">self_improvement</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{lang === 'de' ? 'Geistliche Übung' : 'Spiritual Practice'}</span>
                    <span class="media-card-title">{media.practice.title}</span>
                  </div>
                </div>
                <div class="media-card-arrow">
                  <span class="material-symbols-rounded">arrow_forward</span>
                </div>
              </div>
            </button>
          )}

          {songs.map((song) => (
            <div class="col-span-1 sm:col-span-2 lg:col-span-3">
              <SongPlayer song={song} lang={lang} />
            </div>
          ))}

          {media.podcast && (
            <button
              class="media-card media-card-podcast group"
              onclick={`document.getElementById('${podcastModalId}').showModal()`}
              type="button"
            >
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-podcast">
                    <span class="material-symbols-rounded text-xl">podcasts</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">Podcast {media.podcast.duration ? `· ${media.podcast.duration}` : ''}</span>
                    <span class="media-card-title">{media.podcast.title}</span>
                  </div>
                </div>
                <div class="media-card-arrow">
                  <span class="material-symbols-rounded">arrow_forward</span>
                </div>
              </div>
            </button>
          )}

          {media.devotional && (
            <div class="media-card media-card-devotional">
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-devotional">
                    <span class="material-symbols-rounded text-xl">sunny</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{
                      lang === 'da' ? 'Daglig andagt' :
                      lang === 'de' ? 'Tägliche Andacht' :
                      lang === 'es' ? 'Devocional diario' :
                      lang === 'fr' ? 'Méditation quotidienne' :
                      lang === 'it' ? 'Meditazione quotidiana' :
                      lang === 'pl' ? 'Codzienna medytacja' :
                      lang === 'pt' ? 'Devocional diário' :
                      lang === 'sv' ? 'Daglig andakt' :
                      lang === 'tr' ? 'Günlük dua' :
                      lang === 'uk' ? 'Щоденна медитація' :
                      'Daily Devotional'
                    } {media.devotional.duration ? `· ${media.devotional.duration}` : ''}</span>
                    <span class="media-card-title">{media.devotional.title}</span>
                  </div>
                </div>
                <audio controls class="w-full h-10 mt-3" preload="none">
                  <source src={`/audio/meditations/${media.devotional.mp3}`} type="audio/mpeg" />
                </audio>
              </div>
            </div>
          )}

          {media.spiritualPractice && (
            <div class="media-card media-card-spiritual">
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-spiritual">
                    <span class="material-symbols-rounded text-xl">self_improvement</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{
                      lang === 'da' ? 'Åndelig praksis' :
                      lang === 'de' ? 'Geistliche Übung' :
                      lang === 'es' ? 'Práctica espiritual' :
                      lang === 'fr' ? 'Pratique spirituelle' :
                      lang === 'it' ? 'Pratica spirituale' :
                      lang === 'pl' ? 'Praktyka duchowa' :
                      lang === 'pt' ? 'Prática espiritual' :
                      lang === 'sv' ? 'Andlig övning' :
                      lang === 'tr' ? 'Ruhani uygulama' :
                      lang === 'uk' ? 'Духовна практика' :
                      'Spiritual Practice'
                    } {media.spiritualPractice.duration ? `· ${media.spiritualPractice.duration}` : ''}</span>
                    <span class="media-card-title">{media.spiritualPractice.title}</span>
                  </div>
                </div>
                <audio controls class="w-full h-10 mt-3" preload="none">
                  <source src={`/audio/meditations/${media.spiritualPractice.mp3}`} type="audio/mpeg" />
                </audio>
              </div>
            </div>
          )}

          {exegesis && (
            <a
              href={`${exegesisBasePath}#${exegesis.section}`}
              class="media-card media-card-exegesis group"
            >
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-exegesis">
                    <span class="material-symbols-rounded text-xl">menu_book</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{
                      lang === 'da' ? 'Eksegese' :
                      lang === 'de' ? 'Exegese' :
                      lang === 'es' ? 'Exégesis' :
                      lang === 'fr' ? 'Exégèse' :
                      lang === 'it' ? 'Esegesi' :
                      lang === 'pl' ? 'Egzegeza' :
                      lang === 'pt' ? 'Exegese' :
                      lang === 'sv' ? 'Exeges' :
                      lang === 'tr' ? 'Tefsir' :
                      lang === 'uk' ? 'Екзегеза' :
                      'Exegesis'
                    }</span>
                    <span class="media-card-title">{
                      lang === 'da' ? 'Studér dybere' :
                      lang === 'de' ? 'Tiefer studieren' :
                      lang === 'es' ? 'Estudiar más' :
                      lang === 'fr' ? 'Approfondir' :
                      lang === 'it' ? 'Approfondire' :
                      lang === 'pl' ? 'Studiuj głębiej' :
                      lang === 'pt' ? 'Estudar mais' :
                      lang === 'sv' ? 'Studera djupare' :
                      lang === 'tr' ? 'Derinlemesine çalış' :
                      lang === 'uk' ? 'Вивчати глибше' :
                      'Study deeper'
                    }</span>
                  </div>
                </div>
                <div class="media-card-arrow">
                  <span class="material-symbols-rounded">arrow_forward</span>
                </div>
              </div>
            </a>
          )}

        </div>
      </div>
    )}

  </div>
</section>

<!-- Practice Modal -->
{media.practice && (
  <dialog id={practiceModalId} class="modal p-0 rounded-2xl max-w-2xl w-full mx-auto backdrop:bg-black/50">
    <div class="modal-content p-8 md:p-12">
      <header class="flex justify-between items-start mb-8">
        <div>
          <p class="text-xs tracking-widest opacity-60 mb-2" style="color: var(--color-accent)">
            {lang === 'de' ? 'GEISTLICHE ÜBUNG' : 'SPIRITUAL PRACTICE'}
          </p>
          <h3 class="headline-mixed text-2xl md:text-3xl" set:html={formatTitle(media.practice.title)} />
        </div>
        <button onclick={`document.getElementById('${practiceModalId}').close()`} class="text-2xl opacity-40 hover:opacity-100" type="button">&times;</button>
      </header>
      <div class="leading-relaxed" style="color: var(--color-text)">
        {practiceContentHtml ? (
          <div class="practice-content prose prose-lg max-w-none" set:html={practiceContentHtml} />
        ) : (
          <p class="mb-6">{lang === 'de' ? 'Eine kontemplative Übung basierend auf diesem Abschnitt.' : 'A contemplative practice based on this passage.'}</p>
        )}
      </div>
      <footer class="mt-8 pt-6 border-t" style="border-color: var(--color-border)">
        <button onclick={`document.getElementById('${practiceModalId}').close()`} class="px-6 py-2 rounded-full text-sm text-white" style="background: var(--color-accent)" type="button">
          {lang === 'de' ? 'Schließen' : 'Close'}
        </button>
      </footer>
    </div>
  </dialog>
)}

<!-- Podcast Modal -->
{media.podcast && (
  <dialog id={podcastModalId} class="modal p-0 rounded-2xl max-w-2xl w-full mx-auto backdrop:bg-black/50">
    <div class="modal-content p-8 md:p-12">
      <header class="flex justify-between items-start mb-8">
        <div>
          <p class="text-xs tracking-widest opacity-60 mb-2" style="color: var(--color-accent)">
            PODCAST {media.podcast.duration ? `· ${media.podcast.duration}` : ''}
          </p>
          <h3 class="headline-mixed text-2xl md:text-3xl">{title}</h3>
          <p class="text-sm mt-2" style="color: var(--color-text-muted)">
            {lang === 'de' ? 'Lukas' : 'Luke'} {verses}
          </p>
        </div>
        <button onclick={`document.getElementById('${podcastModalId}').close()`} class="text-2xl opacity-40 hover:opacity-100" type="button">&times;</button>
      </header>
      {media.podcast.mp3 ? (
        <div class="podcast-player">
          <audio controls class="w-full" preload="metadata">
            <source src={`/audio/podcasts/${media.podcast.mp3}`} type="audio/mpeg" />
          </audio>
        </div>
      ) : (
        <p class="opacity-70 italic">{lang === 'de' ? 'Podcast-Episode kommt bald.' : 'Podcast episode coming soon.'}</p>
      )}
      <footer class="mt-8 pt-6 border-t" style="border-color: var(--color-border)">
        <button onclick={`document.getElementById('${podcastModalId}').close()`} class="px-6 py-2 rounded-full text-sm text-white" style="background: var(--color-accent)" type="button">
          {lang === 'de' ? 'Schließen' : 'Close'}
        </button>
      </footer>
    </div>
  </dialog>
)}

<style>
  .pericope-card {
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }

  .pericope-card:nth-child(even) {
    background-color: var(--color-paper);
  }

  /* Audiobible play button */
  .audiobible-play-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-beige);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: var(--color-accent);
  }

  .audiobible-play-btn:hover {
    background: var(--color-sand);
    transform: scale(1.05);
  }

  .audiobible-play-btn .material-symbols-rounded {
    font-size: 28px;
  }

  .audiobible-play-btn.playing {
    background: var(--color-accent);
    color: white;
  }

  /* Image - offset left, right edge aligns with text */
  .editorial-image {
    max-width: 85%;
    margin-left: -2%;
  }

  @media (min-width: 768px) {
    .editorial-image {
      max-width: calc(20% + 36rem); /* left offset + text width */
      margin-left: 0;
      margin-right: auto;
    }
  }

  .editorial-image img {
    border-radius: 4px;
  }

  /* Verses container */
  .verses-container {
    line-height: 1.85;
  }

  .prose-section {
    margin-bottom: 0.5rem;
  }

  /* Poetry block - continuous */
  .poetry-block {
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .poetry-verse {
    display: block;
    margin-bottom: 0.4em;
  }

  .poetry-verse:last-child {
    margin-bottom: 0;
  }

  .poetry-verse .verse-text {
    display: contents;
  }

  :global(.poetry-line-1) {
    display: block;
  }

  :global(.poetry-line-2) {
    display: block;
    padding-left: 1.5rem;
  }

  :global(.poetry-line-3) {
    display: block;
    padding-left: 3rem;
  }

  /* Last poetry line should be inline to allow footnote to follow */
  .verse-text :global(span:last-child) {
    display: inline;
  }

  /* Footnotes list */
  .footnotes-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footnote-item {
    padding: 0.25rem 0;
  }

  .footnote-details {
    border-radius: 8px;
    transition: background-color 0.15s ease;
  }

  .footnote-details[open] {
    background: var(--color-beige);
    padding: 0.5rem;
    margin: -0.5rem;
  }

  .footnote-summary {
    list-style: none;
    padding: 0.5rem;
    margin: -0.5rem;
    border-radius: 8px;
    transition: background-color 0.15s ease;
  }

  .footnote-summary::-webkit-details-marker {
    display: none;
  }

  .footnote-summary:hover {
    background: var(--color-beige);
  }

  .footnote-details[open] .footnote-summary {
    background: transparent;
  }

  .footnote-details[open] .footnote-summary:hover {
    background: rgba(0,0,0,0.03);
  }

  .footnote-chevron {
    transition: transform 0.2s ease;
  }

  .footnote-details[open] .footnote-chevron {
    transform: rotate(180deg);
  }

  .footnote-content {
    animation: slideDown 0.2s ease;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Media cards */
  .media-card {
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.25s ease;
    text-align: left;
    cursor: pointer;
  }

  .media-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    border-color: var(--color-border-strong);
  }

  .media-card-inner {
    padding: 1rem;
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .media-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .media-icon-wrapper {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--color-beige), var(--color-sand));
    color: var(--color-accent);
  }

  .media-icon-practice {
    background: linear-gradient(135deg, #E8E4F0, #D4CDE8);
    color: #6B5A8E;
  }

  .media-icon-song {
    background: linear-gradient(135deg, #F0E8E4, #E8D4C4);
    color: #8E6B5A;
  }

  .media-icon-podcast {
    background: linear-gradient(135deg, #E4F0E8, #C4E8D4);
    color: #5A8E6B;
  }

  .media-icon-devotional {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    color: #E65100;
  }

  .media-icon-spiritual {
    background: linear-gradient(135deg, #E8E4F0, #D4CDE8);
    color: #6B5A8E;
  }

  .media-icon-exegesis {
    background: linear-gradient(135deg, #E4E8F0, #C4D4E8);
    color: #5A6B8E;
  }

  .media-card-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .media-card-label {
    display: block;
    font-family: 'Switzer', -apple-system, sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
