  }

  .practice-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .practice-content :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .practice-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .practice-content :global(li) {
