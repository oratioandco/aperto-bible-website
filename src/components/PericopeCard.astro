  dialog {
    border: none;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  dialog[open] {
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  audio {
    border-radius: 8px;
  }
  audio::-webkit-media-controls-panel {
    background: var(--color-beige);
  }
</style>

<script>
  // Inline footnote touch handling for mobile devices
  function initFootnoteTooltips() {
    const footnotes = document.querySelectorAll('.footnote-inline');

    footnotes.forEach(el => {
      el.addEventListener('click', (e) => {
        // Only handle on touch devices
        if (window.matchMedia('(hover: none)').matches) {
          e.preventDefault();
          e.stopPropagation();

          // Close other open tooltips
          document.querySelectorAll('.footnote-inline.active').forEach(other => {
            if (other !== el) {
              other.classList.remove('active');
            }
          });

          // Toggle this tooltip
          el.classList.toggle('active');
        }
      });
    });

    // Close tooltips when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.footnote-inline')) {
        document.querySelectorAll('.footnote-inline.active').forEach(el => {
          el.classList.remove('active');
        });
      }
    });

    // Close tooltips on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.footnote-inline.active').forEach(el => {
          el.classList.remove('active');
        });
      }
    });
  }

  // Initialize on page load and after navigation
  document.addEventListener('DOMContentLoaded', initFootnoteTooltips);
  document.addEventListener('astro:page-load', initFootnoteTooltips);

  // Audiobible pericope playback
  let audioBibleAudio = null;
  let currentPlayingBtn = null;

  // Helper function to open the global karaoke modal (shared with SongPlayer)
  function openAudioBibleKaraoke(mp3, title, transcriptPath, startMs) {
    const modal = document.getElementById('global-karaoke-modal');
    if (!modal) {
      console.error('Karaoke modal not found');
      return;
    }

    const titleElement = document.getElementById('karaoke-title');
    const lyricsContainer = document.getElementById('lyrics-scroll-container');

    if (titleElement) {
      titleElement.textContent = title;
    }

    // Show modal
    modal.showModal();

    // Show loading
    if (lyricsContainer) {
      lyricsContainer.innerHTML = `
        <div class="lyrics-loading">
          <span class="material-symbols-rounded spinning">refresh</span>
          <span>Loading...</span>
        </div>
      `;
    }

    // Load transcript and setup - dispatch event for SongPlayer's karaoke system
    const event = new CustomEvent('openKaraoke', {
      detail: { mp3, title, transcriptPath, startMs }
    });
    window.dispatchEvent(event);
  }

  function initAudioBibleButtons() {
    // Header play buttons
    const buttons = document.querySelectorAll('.audiobible-play-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const hasKaraoke = btn.dataset.hasKaraoke === 'true';
        const mp3 = btn.dataset.mp3;
        const startMs = parseInt(btn.dataset.startMs, 10) || 0;
        const title = btn.dataset.title || 'Audio Bible';
        const transcriptPath = btn.dataset.transcript;

        // If has karaoke capability, open the karaoke modal
        if (hasKaraoke && transcriptPath) {
          openAudioBibleKaraoke(mp3, title, transcriptPath, startMs);
          return;
        }

        // Otherwise, use inline playback (fallback for no transcript)
        // If clicking the same button that's playing, toggle pause/play
        if (currentPlayingBtn === btn && audioBibleAudio) {
          if (audioBibleAudio.paused) {
            audioBibleAudio.play();
            btn.classList.add('playing');
            btn.querySelector('.material-symbols-rounded').textContent = 'pause_circle';
          } else {
            audioBibleAudio.pause();
            btn.classList.remove('playing');
            btn.querySelector('.material-symbols-rounded').textContent = 'play_circle';
          }
          return;
        }

        // Stop any existing playback
        if (audioBibleAudio) {
          audioBibleAudio.pause();
          audioBibleAudio = null;
        }
        if (currentPlayingBtn) {
          currentPlayingBtn.classList.remove('playing');
          currentPlayingBtn.querySelector('.material-symbols-rounded').textContent = 'play_circle';
        }

        // Create new audio and start at pericope position
        audioBibleAudio = new Audio(mp3);
        audioBibleAudio.currentTime = startMs / 1000;

        audioBibleAudio.addEventListener('canplay', () => {
          audioBibleAudio.play();
        }, { once: true });

        audioBibleAudio.addEventListener('ended', () => {
          btn.classList.remove('playing');
          btn.querySelector('.material-symbols-rounded').textContent = 'play_circle';
          currentPlayingBtn = null;
        });

        audioBibleAudio.addEventListener('error', (e) => {
          console.error('Audio error:', e);
          btn.classList.remove('playing');
          btn.querySelector('.material-symbols-rounded').textContent = 'play_circle';
          currentPlayingBtn = null;
        });

        // Update UI
        btn.classList.add('playing');
        btn.querySelector('.material-symbols-rounded').textContent = 'pause_circle';
        currentPlayingBtn = btn;
      });
    });

    // Media card karaoke buttons
    const karaokeButtons = document.querySelectorAll('.audiobible-karaoke-btn');
    karaokeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mp3 = btn.dataset.mp3;
        const title = btn.dataset.title || 'Audio Bible';
        const transcriptPath = btn.dataset.transcript;
        const startMs = parseInt(btn.dataset.startMs, 10) || 0;

        openAudioBibleKaraoke(mp3, title, transcriptPath, startMs);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initAudioBibleButtons);
  document.addEventListener('astro:page-load', initAudioBibleButtons);
</script>
