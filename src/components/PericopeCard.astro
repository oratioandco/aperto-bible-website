<script>
  // Cursor-positioned footnote tooltips with viewport detection
  const OFFSET = 12; // Distance from cursor
  const PADDING = 10; // Viewport edge padding

  function positionTooltip(tooltip, mouseX, mouseY) {
    // Force a reflow to get accurate dimensions
    tooltip.style.visibility = 'hidden';
    tooltip.style.display = 'block';

    const tooltipRect = tooltip.getBoundingClientRect();
    const tooltipWidth = tooltipRect.width;
    const tooltipHeight = tooltipRect.height;

    const viewportWidth = window.innerWidth;
    const viewportHeight = window.innerHeight;

    let x = mouseX + OFFSET;
    let y = mouseY - tooltipHeight - OFFSET; // Default: above cursor
    let arrowClass = 'arrow-bottom';

    // Check if tooltip goes off right edge
    if (x + tooltipWidth + PADDING > viewportWidth) {
      x = mouseX - tooltipWidth - OFFSET;
    }

    // Check if tooltip goes off left edge
    if (x < PADDING) {
      x = PADDING;
    }

    // Check if tooltip goes off top edge
    if (y < PADDING) {
      y = mouseY + OFFSET; // Position below cursor
      arrowClass = 'arrow-top';
    }

    // Check if tooltip goes off bottom edge
    if (y + tooltipHeight + PADDING > viewportHeight) {
      y = viewportHeight - tooltipHeight - PADDING;
    }

    tooltip.style.left = x + 'px';
    tooltip.style.top = y + 'px';
    tooltip.style.visibility = '';
    tooltip.style.display = '';

    // Update arrow position
    tooltip.classList.remove('arrow-top', 'arrow-bottom');
    tooltip.classList.add(arrowClass);

    // Position arrow relative to cursor
    const arrowLeft = Math.max(12, Math.min(mouseX - x, tooltipWidth - 12));

    // Set CSS variable for arrow position
    tooltip.style.setProperty('--arrow-left', arrowLeft + 'px');
  }

  function initFootnoteTooltips() {
    const footnotes = document.querySelectorAll('.footnote-inline');

    footnotes.forEach(el => {
      const tooltip = el.querySelector('.footnote-tooltip');
      if (!tooltip) return;

      // Track mouse position for cursor-based positioning (desktop)
      el.addEventListener('mousemove', (e) => {
        positionTooltip(tooltip, e.clientX, e.clientY);
      });

      // Handle click for touch devices
      el.addEventListener('click', (e) => {
        if (window.matchMedia('(hover: none)').matches) {
          e.preventDefault();
          e.stopPropagation();

          // Close other open tooltips
          document.querySelectorAll('.footnote-inline.active').forEach(other => {
            if (other !== el) {
              other.classList.remove('active');
            }
          });

          // Position tooltip at touch point
          const touch = e.touches ? e.touches[0] : e;
          positionTooltip(tooltip, touch.clientX, touch.clientY);

          // Toggle this tooltip
          el.classList.toggle('active');
        }
      });
    });

    // Close tooltips when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.footnote-inline')) {
        document.querySelectorAll('.footnote-inline.active').forEach(el => {
          el.classList.remove('active');
        });
      }
    });

    // Close tooltips on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.footnote-inline.active').forEach(el => {
          el.classList.remove('active');
        });
      }
    });
  }

  // Initialize on page load and after navigation
  document.addEventListener('DOMContentLoaded', initFootnoteTooltips);
  document.addEventListener('astro:page-load', initFootnoteTooltips);

  // Unified audio playback via mini-player
  function initMediaPlayButtons() {
    // Header audiobible play buttons
    const headerButtons = document.querySelectorAll('.audiobible-play-btn');
    headerButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const hasKaraoke = btn.dataset.hasKaraoke === 'true';
        const mp3 = btn.dataset.mp3;
        const startMs = parseInt(btn.dataset.startMs, 10) || 0;
        const title = btn.dataset.title || 'Audio Bible';
        const transcriptPath = btn.dataset.transcript;

        // Dispatch to mini-player
        const event = new CustomEvent('playAudio', {
          detail: {
            type: 'audiobible',
            mp3,
            title,
            artist: 'Aperto Bible',
            transcriptPath: hasKaraoke ? transcriptPath : undefined,
            startMs,
            hasLyrics: hasKaraoke
          }
        });
        window.dispatchEvent(event);
      });
    });

    // Media card play buttons (podcast, meditation, spiritual, audiobible)
    const mediaButtons = document.querySelectorAll('.media-play-btn');
    mediaButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.type || 'audio';
        const mp3 = btn.dataset.mp3;
        const title = btn.dataset.title || 'Audio';
        const artist = btn.dataset.artist || 'Aperto Bible';
        const coverArt = btn.dataset.coverArt;
        const transcriptPath = btn.dataset.transcript;
        const startMs = parseInt(btn.dataset.startMs, 10) || 0;
        const hasLyrics = btn.dataset.hasLyrics === 'true';

        // Dispatch to mini-player
        const event = new CustomEvent('playAudio', {
          detail: {
            type,
            mp3,
            title,
            artist,
            coverArt: coverArt || undefined,
            transcriptPath: transcriptPath || undefined,
            startMs,
            hasLyrics
          }
        });
        window.dispatchEvent(event);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initMediaPlayButtons);
  document.addEventListener('astro:page-load', initMediaPlayButtons);

  // Share button functionality
  function initShareButtons() {
    const shareButtons = document.querySelectorAll('.media-share-btn');

    shareButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const shareHash = btn.getAttribute('data-share');
        const fullUrl = window.location.origin + window.location.pathname + shareHash;

        // Copy to clipboard
        navigator.clipboard.writeText(fullUrl).then(() => {
          // Show copied state
          const icon = btn.querySelector('.material-symbols-rounded');
          const originalText = icon.textContent;

          btn.classList.add('copied');
          icon.textContent = 'check';

          // Reset after 2 seconds
          setTimeout(() => {
            btn.classList.remove('copied');
            icon.textContent = originalText;
          }, 2000);
        }).catch(err => {
          console.error('Failed to copy:', err);
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initShareButtons);
  document.addEventListener('astro:page-load', initShareButtons);

  // Feedback buttons — open Tally popup with context pre-filled
  function initFeedbackButtons() {
    document.querySelectorAll('.feedback-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (typeof Tally === 'undefined') return;
        Tally.openPopup(btn.dataset.tallyId, {
          hiddenFields: {
            lang: btn.dataset.lang || '',
            pericope: btn.dataset.pericope || '',
            chapter: btn.dataset.chapter || '',
          },
          overlay: true,
          emoji: { text: '👋', animation: 'wave' },
        });
      });
    });
  }
  document.addEventListener('DOMContentLoaded', initFeedbackButtons);
  document.addEventListener('astro:page-load', initFeedbackButtons);
</script>
