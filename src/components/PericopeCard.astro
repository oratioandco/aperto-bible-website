---
import { marked } from 'marked';
import SongPlayer from './SongPlayer.astro';
import { useTranslations } from '../i18n/utils';

interface Song {
  description?: string;
  title: string;
  mp3: string;
  genre: string;
  transcriptPath?: string;
}

interface Footnote {
  ref: string;
  category: string;
  keyword: string;
  content: string;
}

interface Props {
  id: string;
  title: string;
  subtitle: string;
  verses: string;
  color?: string;
  accentColor?: string;
  image?: string;
  imageAlt?: string;
  verseData: any[];
  media: {
    practice?: { title: string; verseRef: string; content?: string };
    song?: { title: string; mp3: string };
    songs?: Song[];
    podcast?: { title: string; duration?: string; description?: string; scriptFile?: string; mp3?: string };
    audioBible?: { title: string; mp3: string; transcriptPath?: string };
    devotional?: { title: string; mp3: string; duration?: string };
    reflexionen?: { title: string; mp3: string; duration?: string };
    spiritualPractice?: { title: string; mp3: string; duration?: string };
  };
  exegesis?: {
    section: string;
    label: string;
  };
  lang: string;
  chapter?: number;
  isFirst?: boolean;
  layoutIndex?: number;
  audioBibleStart?: number;
  audioBibleMp3?: string;
  audioBibleTranscriptPath?: string;
}

const { id, title, subtitle, verses, image, imageAlt, verseData, media, exegesis, lang, chapter = 1, isFirst, layoutIndex = 0, audioBibleStart, audioBibleMp3, audioBibleTranscriptPath } = Astro.props;
const t = useTranslations(lang);

// Determine if audiobible has karaoke capability
const audioBibleHasTranscript = !!(audioBibleTranscriptPath || media.audioBible?.transcriptPath);
const resolvedAudioBibleTranscriptPath = audioBibleTranscriptPath || media.audioBible?.transcriptPath;

// Audiobible playback ID for this pericope
const audioBiblePlayerId = `audiobible-player-${id}`;

// Parse practice content from markdown to HTML
const practiceContentHtml = media.practice?.content ? marked.parse(media.practice.content) : '';
const base = '';

// Determine the exegesis URL based on language availability
// New languages have localized exegesis, others fall back to English
const localizedExegesisLangs = ['da', 'es', 'it', 'pt', 'sv', 'uk'];
const exegesisBasePath = localizedExegesisLangs.includes(lang)
  ? `${base}/${lang}/exegesis/luke/${chapter}`
  : `${base}/exegesis/luke/${chapter}`;

const songs: Song[] = media.songs || (media.song ? [{ ...media.song, genre: '' }] : []);
const hasMedia = media.practice || songs.length > 0 || media.podcast || exegesis || media.audioBible;


// Collect all footnotes for mobile view
const allFootnotes: (Footnote & { verseNum: number; verseIdx: number; fnIdx: number })[] = [];
verseData.forEach((verse, idx) => {
  verse.footnotes.forEach((fn: Footnote, fnIdx: number) => {
    allFootnotes.push({ ...fn, verseNum: verse.number, verseIdx: idx, fnIdx });
  });
});

// Group verses into poetry blocks and prose sections
type VerseGroup = { type: 'prose' | 'poetry'; verses: { verse: any; idx: number }[] };
const verseGroups: VerseGroup[] = [];
let currentGroup: VerseGroup | null = null;

verseData.forEach((verse, idx) => {
  const type = verse.isPoetry ? 'poetry' : 'prose';
  if (!currentGroup || currentGroup.type !== type) {
    currentGroup = { type, verses: [] };
    verseGroups.push(currentGroup);
  }
  currentGroup.verses.push({ verse, idx });
});

const practiceModalId = `practice-modal-${id}`;

// Category icons
const categoryIcons: Record<string, string> = {
  text: 'translate',
  kultur: 'public', culture: 'public',
  leben: 'favorite', life: 'favorite',
  kontext: 'link', context: 'link',
  unglaublich: 'help', hard: 'help'
};

// Map raw category keys (including German legacy keys) to i18n keys
const categoryToI18nKey: Record<string, string> = {
  text: 'text',
  kultur: 'culture', culture: 'culture',
  leben: 'life',    life: 'life',
  kontext: 'context', context: 'context',
  unglaublich: 'difficult', hard: 'difficult',
};

function getCategoryLabel(category: string): string {
  const key = categoryToI18nKey[category.toLowerCase()];
  if (key) return t(`reader.footnote.${key}`);
  return category;
}

function fnKey(verseNum: any, keyword: string): string {
  const slug = keyword.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
  return `${verseNum}-${slug}`;
}

// Process verse text to add inline footnote tooltips
function processVerseWithFootnotes(text: string, footnotes: Footnote[], verseNum: any): { html: string; unmatchedFootnotes: Footnote[] } {
  if (!footnotes || footnotes.length === 0) {
    return { html: text, unmatchedFootnotes: [] };
  }

  let processed = text;
  const matched = new Set<number>();

  footnotes.forEach((fn, idx) => {
    // Extract base keyword (before parentheses for Greek terms like "Theophilus (Θεόφιλος)")
    const baseKeyword = fn.keyword.split('(')[0].trim();

    // Skip if keyword is empty or too short
    if (!baseKeyword || baseKeyword.length < 2) return;

    // Check if keyword exists in text (case-insensitive search, but preserve original case)
    const keywordRegex = new RegExp(`(?<![\\w-])${baseKeyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\w-])`, 'i');
    const match = processed.match(keywordRegex);

    if (match) {
      const originalKeyword = match[0];
      const category = fn.category.toLowerCase();
      const categoryLabel = getCategoryLabel(category);
      const icon = categoryIcons[category] || 'info';
      const key = fnKey(verseNum, fn.keyword);

      // Escape HTML in content to prevent XSS
      const escapedContent = fn.content
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
      const escapedKeyword = fn.keyword
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

      // Create tooltip wrapper
      const replacement = `<span class="footnote-inline" data-verse="${verseNum}" data-fn-key="${key}" tabindex="0"><span class="footnote-trigger">${originalKeyword}</span><span class="footnote-tooltip"><span class="footnote-tooltip-header"><span class="material-symbols-rounded footnote-tooltip-icon">${icon}</span><span class="footnote-tooltip-category footnote-category-${category}">${categoryLabel}</span></span><span class="footnote-tooltip-keyword">${escapedKeyword}</span><span class="footnote-tooltip-content">${escapedContent}</span></span></span>`;

      // Replace first occurrence only
      processed = processed.replace(keywordRegex, replacement);
      matched.add(idx);
    }
  });

  // Collect unmatched footnotes for additional notes section
  const unmatchedFootnotes = footnotes.filter((_, idx) => !matched.has(idx));

  return { html: processed, unmatchedFootnotes };
}

// Process all verses and collect unmatched footnotes
const processedVerses = verseData.map((verse) => {
  const result = processVerseWithFootnotes(verse.text, verse.footnotes || [], verse.number);
  return {
    ...verse,
    processedText: result.html,
    unmatchedFootnotes: result.unmatchedFootnotes
  };
});

// Collect all unmatched footnotes for "Additional Notes" section
const additionalNotes: (Footnote & { verseNum: number })[] = [];
processedVerses.forEach((verse) => {
  verse.unmatchedFootnotes.forEach((fn: Footnote) => {
    additionalNotes.push({ ...fn, verseNum: verse.number });
  });
});

// Update verse groups to use processed verses
const processedVerseGroups: VerseGroup[] = [];
let currentProcessedGroup: VerseGroup | null = null;

processedVerses.forEach((verse, idx) => {
  const type = verse.isPoetry ? 'poetry' : 'prose';
  if (!currentProcessedGroup || currentProcessedGroup.type !== type) {
    currentProcessedGroup = { type, verses: [] };
    processedVerseGroups.push(currentProcessedGroup);
  }
  // Prepend an invisible anchor span for scroll sync
  verse.processedText = `<span class="verse-anchor" data-verse-anchor="${verse.number}"></span>` + (verse.processedText || '');
  currentProcessedGroup.verses.push({ verse, idx });
});

// Split a prose verse group into paragraphs based on paragraph-break markers.
// The marker can appear at the start, end, or middle of any verse's text.
const PARA_BREAK = '<span class="paragraph-break"></span>';
function splitIntoParagraphs(verses: { verse: any; idx: number }[]): string[] {
  const paragraphs: string[] = [];
  let current = '';

  for (const { verse } of verses) {
    if (!verse.processedText) continue;

    const parts = verse.processedText.split(PARA_BREAK);
    if (parts.length === 1) {
      current += (current ? ' ' : '') + parts[0];
    } else {
      for (let i = 0; i < parts.length; i++) {
        if (i === 0) {
          current += (current ? ' ' : '') + parts[0];
        } else {
          if (current.trim()) paragraphs.push(current.trim());
          current = parts[i];
        }
      }
    }
  }

  if (current.trim()) paragraphs.push(current.trim());
  return paragraphs.filter(Boolean);
}
---

<section class="pericope-card py-16 md:py-24" id={id}>
  <div class="editorial-container max-w-6xl mx-auto px-6 md:px-12">

    <!-- Header -->
    <header class="editorial-header mb-6 max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%]">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="passage-reference mb-2">
            {t('reader.luke')} {verses}
          </p>
          <h2 class="headline-mixed text-3xl md:text-4xl lg:text-5xl leading-[1.1]">{title}</h2>
        </div>
        {audioBibleStart !== undefined && audioBibleMp3 && (
          <button
            class={`audiobible-play-btn flex-shrink-0 ${audioBibleHasTranscript ? 'has-karaoke' : ''}`}
            data-player-id={audioBiblePlayerId}
            data-mp3={`/audio/audiobible/${audioBibleMp3}`}
            data-start-ms={audioBibleStart}
            data-pericope-id={id}
            data-title={media.audioBible?.title || t('reader.audioBible')}
            data-transcript={audioBibleHasTranscript ? resolvedAudioBibleTranscriptPath : ''}
            data-has-karaoke={audioBibleHasTranscript ? 'true' : 'false'}
            type="button"
            aria-label={t('reader.playAudioBible')}
            title={t('reader.playAudioBible')}
          >
            <span class="material-symbols-rounded">play_circle</span>
          </button>
        )}
      </div>
    </header>

    <!-- Image - offset to left, aligned with text end -->
    {image && (
      <figure class="editorial-image mb-10">
        <img
          src={`${base}/images/luke/${chapter}/${image}`}
          alt={imageAlt || title}
          class="w-full aspect-video object-cover rounded"
          loading="lazy"
        />
      </figure>
    )}

    <!-- Verses - grouped by prose/poetry with inline footnotes -->
    <div class="verses-container max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%]">
      {processedVerseGroups.map((group) => (
        group.type === 'poetry' ? (
          <div class="poetry-block">
            {group.verses.map(({ verse, idx }) => (
              <div class="poetry-verse">
                <span class="verse-text" set:html={verse.processedText} />
              </div>
            ))}
          </div>
        ) : (
          <div class="prose-section">
            {splitIntoParagraphs(group.verses).map((paraHtml) => (
              <p class="prose-paragraph" set:html={paraHtml} />
            ))}
          </div>
        )
      ))}
    </div>

    <!-- Additional Notes (for footnotes that couldn't be matched inline) -->
    {additionalNotes.length > 0 && (
      <div class="additional-notes max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%] mt-8 pt-4 border-t" style="border-color: var(--color-border)">
        <p class="text-xs tracking-wider uppercase mb-3" style="color: var(--color-text-muted)">
          {t('reader.additionalNotes')}
        </p>
        <ul class="space-y-2">
          {additionalNotes.map((fn) => (
            <li class="footnote-item">
              <details class="footnote-details">
                <summary class="footnote-summary flex items-center gap-3 cursor-pointer">
                  <div class="footnote-icon flex-shrink-0 w-7 h-7 rounded-lg flex items-center justify-center" style="background: var(--color-beige)">
                    <span class="material-symbols-rounded text-sm" style="color: var(--color-accent)">
                      {categoryIcons[fn.category.toLowerCase()] || 'info'}
                    </span>
                  </div>
                  <span class="footnote-category uppercase tracking-wider text-[10px] font-medium" style="color: var(--color-text-muted)">
                    {getCategoryLabel(fn.category.toLowerCase())}
                  </span>
                  <span class="footnote-keyword font-medium text-sm" style="color: var(--color-accent)">{fn.keyword}</span>
                  <span class="footnote-chevron material-symbols-rounded text-sm ml-auto" style="color: var(--color-text-muted)">expand_more</span>
                </summary>
                <div class="footnote-content pl-10 pt-2 pb-1">
                  <p class="footnote-text text-sm leading-relaxed" style="color: var(--color-text)">{fn.content}</p>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Media Section -->
    {hasMedia && (
      <div class="media-section max-w-xl ml-auto mr-auto md:mr-0 md:ml-[20%] mt-16">
        <div class="media-grid grid grid-cols-1 md:grid-cols-2 gap-4">

          {media.podcast && media.podcast.mp3 && (
            <div class="media-card media-card-podcast" id={`podcast-${id}`}>
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-podcast">
                    <span class="material-symbols-rounded text-xl">podcasts</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">Podcast {media.podcast.duration ? `· ${media.podcast.duration}` : ''}</span>
                    <span class="media-card-title">{media.podcast.title}</span>
                  </div>
                </div>
                <div class="media-card-actions">
                  <button
                    class="media-play-btn"
                    data-type="podcast"
                    data-mp3={`/audio/podcasts/${media.podcast.mp3}`}
                    data-title={media.podcast.title}
                    data-artist={title}
                    data-cover-art="/images/covers/default.png"
                    type="button"
                  >
                    <span class="material-symbols-rounded">play_arrow</span>
                  </button>
                  <button
                    class="media-share-btn"
                    data-share={`#podcast-${id}`}
                    type="button"
                    aria-label="Share"
                    title="Share"
                  >
                    <span class="material-symbols-rounded">share</span>
                  </button>
                </div>
              </div>
            </div>
          )}

          {songs.map((song) => (
            <div class="col-span-1 md:col-span-2">
              <SongPlayer song={song} lang={lang} />
            </div>
          ))}

          {media.devotional && (
            <div class="media-card media-card-devotional" id={`devotional-${id}`}>
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-devotional">
                    <span class="material-symbols-rounded text-xl">sunny</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{
                      lang === 'da' ? 'Morgenandagt' :
                      lang === 'de' ? 'Morgenandacht' :
                      lang === 'es' ? 'Devocional matutino' :
                      lang === 'fr' ? 'Méditation du matin' :
                      lang === 'it' ? 'Meditazione del mattino' :
                      lang === 'pl' ? 'Poranna refleksja' :
                      lang === 'pt' ? 'Devocional matinal' :
                      lang === 'sv' ? 'Morgonandakt' :
                      lang === 'tr' ? 'Sabah ibadeti' :
                      lang === 'uk' ? 'Ранкова молитва' :
                      'Morning Devotional'
                    }{media.devotional.duration ? ` · ${media.devotional.duration}` : ''}</span>
                    <span class="media-card-title">{media.devotional.title}</span>
                    <span class="media-card-description">{
                      lang === 'da' ? 'En tekst og en sang til at begynde din dag' :
                      lang === 'de' ? 'Ein Bibeltext und ein Lied für den Start in den Tag' :
                      lang === 'es' ? 'Un pasaje y una canción para comenzar el día' :
                      lang === 'fr' ? 'Un passage et un chant pour commencer la journée' :
                      lang === 'it' ? 'Un brano e un canto per iniziare la giornata' :
                      lang === 'pl' ? 'Fragment i pieśń na początek dnia' :
                      lang === 'pt' ? 'Uma passagem e uma canção para começar o dia' :
                      lang === 'sv' ? 'En text och en sång för att börja dagen' :
                      lang === 'tr' ? 'Güne başlamak için bir pasaj ve bir şarkı' :
                      lang === 'uk' ? 'Уривок і пісня, щоб почати день' :
                      'A passage and a song to begin your day'
                    }</span>
                  </div>
                </div>
                <div class="media-card-actions">
                  <button
                    class="media-play-btn"
                    data-type="devotional"
                    data-mp3={`/audio/devotionals/${media.devotional.mp3}`}
                    data-title={media.devotional.title}
                    data-artist={title}
                    data-cover-art="/images/covers/morgen.png"
                    type="button"
                  >
                    <span class="material-symbols-rounded">play_arrow</span>
                  </button>
                  <button
                    class="media-share-btn"
                    data-share={`#devotional-${id}`}
                    type="button"
                    aria-label="Share"
                    title="Share"
                  >
                    <span class="material-symbols-rounded">share</span>
                  </button>
                </div>
              </div>
            </div>
          )}

          {media.reflexionen && (
            <div class="media-card media-card-reflexionen" id={`reflexionen-${id}`}>
              <div class="media-card-inner">
                <div class="media-card-header">
                  <div class="media-icon-wrapper media-icon-reflexionen">
                    <span class="material-symbols-rounded text-xl">bedtime</span>
                  </div>
                  <div class="media-card-text">
                    <span class="media-card-label">{
                      lang === 'sq' ? 'Reflektim mbrëmjeje' :
                      lang === 'ar' ? 'تأمل المساء' :
                      lang === 'bg' ? 'Вечерен размисъл' :
                      lang === 'ca' ? 'Reflexió del vespre' :
                      lang === 'cs' ? 'Večerní rozjímání' :
                      lang === 'da' ? 'Aftenandagt' :
                      lang === 'de' ? 'Abendandacht' :
                      lang === 'el' ? 'Βραδινός στοχασμός' :
                      lang === 'es' ? 'Reflexión vespertina' :
                      lang === 'et' ? 'Õhtumõtisklus' :
                      lang === 'fi' ? 'Iltahartaus' :
                      lang === 'fr' ? 'Méditation du soir' :
                      lang === 'ga' ? 'Machnamh tráthnóna' :
                      lang === 'hr' ? 'Večernje razmišljanje' :
                      lang === 'hu' ? 'Esti elmélkedés' :
                      lang === 'it' ? 'Meditazione della sera' :
                      lang === 'lt' ? 'Vakaro apmąstymas' :
                      lang === 'lv' ? 'Vakara pārdomas' :
                      lang === 'mt' ? 'Riflessjoni ta\' filgħaxija' :
                      lang === 'nb' ? 'Kveldsandakt' :
                      lang === 'nl' ? 'Avondoverdenking' :
                      lang === 'pl' ? 'Wieczorna refleksja' :
                      lang === 'pt' ? 'Reflexão da noite' :
                      lang === 'ro' ? 'Reflecție de seară' :
                      lang === 'ru' ? 'Вечернее размышление' :
                      lang === 'sk' ? 'Večerné zamyslenie' :
                      lang === 'sl' ? 'Večerni razmislek' :
                      lang === 'sv' ? 'Kvällsandakt' :
                      lang === 'tr' ? 'Akşam tefekkürü' :
                      lang === 'uk' ? 'Вечірня молитва' :
                      'Evening Reflection'
                    }{media.reflexionen.duration ? ` · ${media.reflexionen.duration}` : ''}</span>
                    <span class="media-card-title">{media.reflexionen.title}</span>
                    <span class="media-card-description">{
                      lang === 'da' ? 'En stille stund til at slutte din dag' :
                      lang === 'de' ? 'Eine stille Betrachtung zum Tagesausklang' :
                      lang === 'es' ? 'Una pausa contemplativa para terminar el día' :
                      lang === 'fr' ? 'Un temps contemplatif pour clore la journée' :
                      lang === 'it' ? 'Un momento contemplativo per concludere la giornata' :
                      lang === 'pl' ? 'Chwila kontemplacji na zakończenie dnia' :
                      lang === 'pt' ? 'Um momento contemplativo para encerrar o dia' :
                      lang === 'sv' ? 'En stilla stund för att avsluta dagen' :
                      lang === 'tr' ? 'Günü kapatmak için sessiz bir an' :
                      lang === 'uk' ? 'Тиха мить, щоб завершити день' :
                      'A quiet moment to close your day'
                    }</span>
                  </div>
                </div>
                <div class="media-card-actions">
                  <button
                    class="media-play-btn"
                    data-type="reflexionen"
                    data-mp3={`/audio/devotionals/${media.reflexionen.mp3}`}
