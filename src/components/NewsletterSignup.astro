---
// Reader exit ramp (WEBSITE-REVIEW Tier-2 fix #6): the newsletter signup,
// placed where a moved reader actually is (homepage, end of a pericope) —
// not only buried on /process. Same SendFox list as the /process form.
// Note: SendFox's script keys on fixed input ids, so use this component at
// most once per page (the /process page keeps its own inline form).
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="newsletter-ramp">
  <div class="ramp-inner">
    <h2>{t('process.newsletter.title')}</h2>
    <p>{t('process.newsletter.intro')}</p>
    <form method="post" action="https://sendfox.com/form/mnwydv/1yr89o" class="sendfox-form" id="1yr89o" data-async="true" data-recaptcha="true">
      <div class="ramp-fields">
        <input type="text" id="sendfox_form_name" placeholder={t('process.newsletter.firstName')} name="first_name" required aria-label={t('process.newsletter.firstName')} />
        <input type="email" id="sendfox_form_email" placeholder={t('process.newsletter.email')} name="email" required aria-label={t('process.newsletter.email')} />
        <button type="submit">{t('process.newsletter.button')}</button>
      </div>
      <label class="ramp-gdpr">
        <input type="checkbox" name="gdpr" value="1" required />
        <span>{t('process.newsletter.agree')}</span>
      </label>
      <div style="position: absolute; left: -5000px;" aria-hidden="true">
        <input type="text" name="a_password" tabindex="-1" value="" autocomplete="off" />
      </div>
    </form>
  </div>
</section>
<script src="https://cdn.sendfox.com/js/form.js" charset="utf-8" is:inline></script>

<style>
  .newsletter-ramp {
    padding: 4rem 2rem;
    background: rgba(245, 230, 220, 0.35);
    border-top: 1px solid #F5E6DC;
  }
  .ramp-inner { max-width: 36rem; margin: 0 auto; text-align: center; }
  h2 {
    font-family: 'Fraunces', Georgia, serif; font-size: clamp(1.5rem, 3.4vw, 2rem);
    color: #2C2C2C; margin: 0 0 0.75rem;
  }
  p {
    font-family: 'Switzer', sans-serif; font-size: 1rem; line-height: 1.6;
    color: #5A5A5A; margin: 0 0 1.5rem;
  }
  .ramp-fields { display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: center; }
  .ramp-fields input {
    flex: 1 1 10rem; min-width: 0; padding: 0.8rem 1rem; border-radius: 6px;
    border: 1px solid #D1D5DB; background: #FFFBF5;
    font-family: 'Switzer', sans-serif; font-size: 0.95rem; color: #2C2C2C;
  }
  .ramp-fields input:focus { outline: none; border-color: #8B7355; }
  .ramp-fields button {
    flex: 0 0 auto; padding: 0.8rem 1.5rem; border-radius: 6px; border: none;
    background: #8B7355; color: #FFFBF5; font-family: 'Switzer', sans-serif;
    font-weight: 500; font-size: 0.95rem; cursor: pointer; transition: opacity 0.15s;
  }
  .ramp-fields button:hover { opacity: 0.9; }
  .ramp-gdpr {
    display: flex; align-items: flex-start; gap: 0.5rem; justify-content: center;
    margin-top: 0.9rem; font-family: 'Switzer', sans-serif; font-size: 0.8rem;
    color: #8B7355; text-align: left; max-width: 28rem; margin-left: auto; margin-right: auto;
  }
  .ramp-gdpr input { margin-top: 0.2rem; }
</style>
