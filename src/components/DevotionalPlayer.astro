---
import { useTranslations } from '../i18n/utils';

interface Devotional {
  title: string;
  mp3: string;
  lang?: string;
  coverArt?: string;
}

interface Props {
  devotional: Devotional;
  lang?: string;
}

const { devotional, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Generate unique IDs
const playerId = `devotional-${Math.random().toString(36).substr(2, 9)}`;

// Cover art for devotionals
const coverArt = devotional.coverArt || '/images/covers/morgen.png';

const label = t('reader.devotional.morning.label');
---

<div class="devotional-player" data-player-id={playerId}>
  <!-- Devotional Card -->
  <div class="devotional-card">
    <div class="devotional-card-content">
      <!-- Cover Art -->
      <div class="devotional-cover">
        <img src={coverArt} alt={devotional.title} class="cover-image" />
      </div>

      <!-- Devotional Info -->
      <div class="devotional-info">
        <span class="devotional-genre">{label}</span>
        <span class="devotional-title">{devotional.title}</span>
      </div>

      <!-- Play Button -->
      <button
        class="play-button"
        data-player-id={playerId}
        data-cover-art={coverArt}
        data-title={devotional.title}
        data-mp3={`/audio/devotionals/${devotional.mp3}`}
        data-type="devotional"
        type="button"
        aria-label="Play"
      >
        <span class="material-symbols-rounded">play_arrow</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Devotional Card */
  .devotional-card {
    background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .devotional-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(230, 81, 0, 0.15);
    border-color: var(--color-border-strong);
  }

  .devotional-card-content {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    align-items: center;
  }

  .devotional-cover {
    width: 100px;
    height: 100px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(230, 81, 0, 0.2);
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .devotional-info {
    flex: 1;
    min-width: 0;
  }

  .devotional-genre {
    font-family: 'Switzer', -apple-system, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #E65100;
    display: block;
    margin-bottom: 0.25rem;
  }

  .devotional-title {
    font-family: 'Switzer', -apple-system, sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-charcoal);
    display: block;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .play-button {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #E65100;
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(230, 81, 0, 0.3);
    transition: all 0.2s ease;
  }

  .play-button:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 16px rgba(230, 81, 0, 0.4);
  }

  .play-button .material-symbols-rounded {
    font-size: 32px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .devotional-card-content {
      flex-direction: row;
      text-align: left;
      padding: 0.75rem;
    }

    .devotional-cover {
      width: 60px;
      height: 60px;
    }

    .devotional-genre {
      font-size: 0.6rem;
    }

    .devotional-title {
      font-size: 0.9rem;
    }

    .play-button {
      width: 40px;
      height: 40px;
    }

    .play-button .material-symbols-rounded {
      font-size: 24px;
    }
  }
</style>

<script>
  // Play button click handler - dispatches to global mini-player
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('.play-button');
    if (!trigger || !trigger.classList.contains('play-button')) return;

    const coverArt = trigger.getAttribute('data-cover-art');
    const title = trigger.getAttribute('data-title');
    const mp3 = trigger.getAttribute('data-mp3');
    const type = trigger.getAttribute('data-type') || 'devotional';

    // Dispatch to mini-player
    const event = new CustomEvent('playAudio', {
      detail: {
        type,
        mp3,
        title,
        artist: 'Aperto Bible',
        coverArt,
        hasLyrics: false
      }
    });
    window.dispatchEvent(event);
  });
</script>
