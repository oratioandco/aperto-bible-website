---
// For static builds, we render the English homepage as default
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const lukeNames = {
  en: 'Luke',
  de: 'Lukas',
  fr: 'Luc',
  pl: 'Łukasz',
  tr: 'Luka',
};
---

<BaseLayout title={t('nav.home')} lang={lang} heroPage={true}>
  <!-- Video Hero -->
  <section class="video-hero">
    <video
      class="video-bg"
      src={`${base}videos/hero.mp4`}
      poster={`${base}images/homepage_hero_blue_hour_low.png`}
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <div class="video-overlay" aria-hidden="true"></div>
    <div class="video-grain" aria-hidden="true" style={`background-image: url(${base}images/grain.gif)`}></div>
    <div class="video-hero-content">
      <h1 class="hero-wordmark tracking-tight logo">aperto</h1>
      <p class="hero-tagline">
        {t('home.tagline')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
        <a href={`${base}${lang}/luke/1`} class="hero-btn">
          {t('home.readLuke')}
        </a>
      </div>
    </div>
  </section>

  <style>
    :global(body) {
      overflow-x: hidden;
    }

    .video-hero {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      clip-path: inset(0);
    }

    .video-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 220px;
      background: linear-gradient(to bottom, transparent 0%, #FFFBF5 100%);
      z-index: 4;
      pointer-events: none;
    }
    .video-bg {
      position: absolute;
      inset: -30px;
      width: calc(100% + 60px);
      height: calc(100% + 60px);
      object-fit: cover;
      object-position: center center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
    }
    .video-overlay {
      position: absolute;
      inset: 0;
      background: rgba(18, 10, 5, 0.38);
      z-index: 1;
    }
    .video-grain {
      position: absolute;
      inset: 0;
      opacity: 0.09;
      background-repeat: repeat;
      background-size: 128px auto;
      z-index: 2;
    }
    .video-hero-content {
      position: relative;
      z-index: 3;
      text-align: center;
      padding: 2rem;
      max-width: 56rem;
      margin: 0 auto;
    }
    .hero-wordmark {
      font-size: clamp(5rem, 16vw, 14rem);
      line-height: 1;
      color: #FFFBF5;
      margin-bottom: 1.5rem;
      text-shadow: 0 2px 32px rgba(0,0,0,0.25);
    }
    .hero-tagline {
      font-size: clamp(1rem, 2.2vw, 1.4rem);
      line-height: 1.6;
      color: rgba(255, 251, 245, 0.82);
      max-width: 36rem;
      margin: 0 auto 2.5rem;
    }
    .hero-btn {
      display: inline-block;
      padding: 0.9rem 2.2rem;
      border-radius: 6px;
      font-weight: 500;
      background-color: rgba(255, 251, 245, 0.15);
      color: #FFFBF5;
      border: 1px solid rgba(255, 251, 245, 0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: background-color 0.2s, border-color 0.2s;
      text-decoration: none;
    }
    .hero-btn:hover {
      background-color: rgba(255, 251, 245, 0.26);
      border-color: rgba(255, 251, 245, 0.55);
    }
    .video-hero::before {
      content: '';
      position: absolute;
      inset: -30px;
      width: calc(100% + 60px);
      height: calc(100% + 60px);
      background-image: url('/images/homepage_hero_blue_hour_low.png');
      background-size: cover;
      background-position: center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .video-bg { display: none; }
      .video-hero::before { opacity: 1; }
    }
  </style>

  <section class="py-24 px-8 md:px-16 lg:px-24" style="background-color: rgba(245, 230, 220, 0.3);">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl mb-12 text-center headline-mixed">{t('home.differentBible')}</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.accessible')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.accessibleDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.multimedia')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.multimediaDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.openSource')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.openSourceDesc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-8 headline-mixed">{t('home.startReading')}</h2>
      <p class="text-lg leading-relaxed mb-12" style="color: #6A6A6A;">
        {t('home.startReadingDesc')}
      </p>
      <a
        href={`${base}${lang}/luke/1`}
        class="inline-block px-8 py-4 rounded font-medium transition-all hover:opacity-90"
        style="background-color: #8B7355; color: #FFFBF5;"
      >
        {lukeNames[lang]} 1
      </a>
    </div>
  </section>
</BaseLayout>
