---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PericopeCard from '../../../../components/PericopeCard.astro';
import ChapterNav from '../../../../components/ChapterNav.astro';

// All 24 pericope metadata files
import pd1 from '../../../../content/luke-1-pericopes-en.json';
import pd2 from '../../../../content/luke-2-pericopes-en.json';
import pd3 from '../../../../content/luke-3-pericopes-en.json';
import pd4 from '../../../../content/luke-4-pericopes-en.json';
import pd5 from '../../../../content/luke-5-pericopes-en.json';
import pd6 from '../../../../content/luke-6-pericopes-en.json';
import pd7 from '../../../../content/luke-7-pericopes-en.json';
import pd8 from '../../../../content/luke-8-pericopes-en.json';
import pd9 from '../../../../content/luke-9-pericopes-en.json';
import pd10 from '../../../../content/luke-10-pericopes-en.json';
import pd11 from '../../../../content/luke-11-pericopes-en.json';
import pd12 from '../../../../content/luke-12-pericopes-en.json';
import pd13 from '../../../../content/luke-13-pericopes-en.json';
import pd14 from '../../../../content/luke-14-pericopes-en.json';
import pd15 from '../../../../content/luke-15-pericopes-en.json';
import pd16 from '../../../../content/luke-16-pericopes-en.json';
import pd17 from '../../../../content/luke-17-pericopes-en.json';
import pd18 from '../../../../content/luke-18-pericopes-en.json';
import pd19 from '../../../../content/luke-19-pericopes-en.json';
import pd20 from '../../../../content/luke-20-pericopes-en.json';
import pd21 from '../../../../content/luke-21-pericopes-en.json';
import pd22 from '../../../../content/luke-22-pericopes-en.json';
import pd23 from '../../../../content/luke-23-pericopes-en.json';
import pd24 from '../../../../content/luke-24-pericopes-en.json';

// All 24 chapter verse content files
import cd1 from '../../../../content/luke-1-en.json';
import cd2 from '../../../../content/luke-2-en.json';
import cd3 from '../../../../content/luke-3-en.json';
import cd4 from '../../../../content/luke-4-en.json';
import cd5 from '../../../../content/luke-5-en.json';
import cd6 from '../../../../content/luke-6-en.json';
import cd7 from '../../../../content/luke-7-en.json';
import cd8 from '../../../../content/luke-8-en.json';
import cd9 from '../../../../content/luke-9-en.json';
import cd10 from '../../../../content/luke-10-en.json';
import cd11 from '../../../../content/luke-11-en.json';
import cd12 from '../../../../content/luke-12-en.json';
import cd13 from '../../../../content/luke-13-en.json';
import cd14 from '../../../../content/luke-14-en.json';
import cd15 from '../../../../content/luke-15-en.json';
import cd16 from '../../../../content/luke-16-en.json';
import cd17 from '../../../../content/luke-17-en.json';
import cd18 from '../../../../content/luke-18-en.json';
import cd19 from '../../../../content/luke-19-en.json';
import cd20 from '../../../../content/luke-20-en.json';
import cd21 from '../../../../content/luke-21-en.json';
import cd22 from '../../../../content/luke-22-en.json';
import cd23 from '../../../../content/luke-23-en.json';
import cd24 from '../../../../content/luke-24-en.json';

const allPericopes = [pd1, pd2, pd3, pd4, pd5, pd6, pd7, pd8, pd9, pd10, pd11, pd12, pd13, pd14, pd15, pd16, pd17, pd18, pd19, pd20, pd21, pd22, pd23, pd24];
const allContent: Record<number, any> = { 1: cd1, 2: cd2, 3: cd3, 4: cd4, 5: cd5, 6: cd6, 7: cd7, 8: cd8, 9: cd9, 10: cd10, 11: cd11, 12: cd12, 13: cd13, 14: cd14, 15: cd15, 16: cd16, 17: cd17, 18: cd18, 19: cd19, 20: cd20, 21: cd21, 22: cd22, 23: cd23, 24: cd24 };

// Build flat global list: [{...pericope, chapter: N}, ...]
const globalPericopes: Array<any> = [];
for (const chData of allPericopes) {
  for (const p of chData.pericopes) {
    globalPericopes.push({ ...p, chapter: chData.chapter });
  }
}

export function getStaticPaths() {
  // Rebuild globalPericopes inside getStaticPaths (Astro requires it to be self-contained)
  const allPd = [pd1, pd2, pd3, pd4, pd5, pd6, pd7, pd8, pd9, pd10, pd11, pd12, pd13, pd14, pd15, pd16, pd17, pd18, pd19, pd20, pd21, pd22, pd23, pd24];
  const flat: Array<any> = [];
  for (const chData of allPd) {
    for (const p of chData.pericopes) {
      flat.push({ ...p, chapter: chData.chapter });
    }
  }
  return flat.map((p, idx) => ({
    params: { chapter: String(p.chapter), pericope: p.id },
    props: {
      pericope: p,
      chapter: p.chapter,
      chapterPericopes: allPd[p.chapter - 1].pericopes,
      prevPericope: idx > 0 ? flat[idx - 1] : null,
      nextPericope: idx < flat.length - 1 ? flat[idx + 1] : null,
      pericopeIndex: idx,
      totalInChapter: allPd[p.chapter - 1].pericopes.length,
      indexInChapter: allPd[p.chapter - 1].pericopes.findIndex((x: any) => x.id === p.id),
    }
  }));
}

const { pericope, chapter, prevPericope, nextPericope, totalInChapter, indexInChapter } = Astro.props;

// Get verse data for this pericope
function getVersesForPericope(verseRange: string, sections: any[]) {
  const allVerses: any[] = [];
  sections.forEach(section => {
    section.verses.forEach((v: any) => allVerses.push(v));
  });
  const parts = verseRange.split('-').map(Number);
  const start = parts[0];
  const end = parts[1] || parts[0];
  return allVerses.filter(v => {
    const vNum = v.number.includes('-') ? parseInt(v.number.split('-')[0]) : parseInt(v.number);
    return vNum >= start && vNum <= end;
  });
}

const chapterContent = allContent[chapter as keyof typeof allContent];
const verseData = getVersesForPericope(pericope.verses, chapterContent.sections);

const base = '';
---

<BaseLayout title={`${pericope.title} — Luke ${chapter}`} lang="en" description={`Luke ${chapter}:${pericope.verses} — ${pericope.title}`}>

  <!-- Top breadcrumb nav -->
  <nav class="pericope-breadcrumb">
    <a href={`${base}/en/luke/${chapter}`}>Luke {chapter}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{pericope.title}</span>
    <span class="breadcrumb-ref">{chapter}:{pericope.verses}</span>
  </nav>

  <!-- Hero image -->
  {pericope.image && (
    <div class="pericope-hero" style={`background-color: ${pericope.color};`}>
      <img src={`/images/luke/${chapter}/${pericope.image}`} alt={pericope.imageAlt || ''} class="pericope-hero-img" />
      <div class="pericope-hero-overlay">
        <p class="pericope-hero-ref">Luke {chapter}:{pericope.verses}</p>
        <h1 class="pericope-hero-title">{pericope.title}</h1>
      </div>
    </div>
  )}

  <!-- Verse content -->
  <div class="pericope-content-wrapper">
    <PericopeCard
      id={pericope.id}
      title={pericope.title}
      subtitle={pericope.subtitle || ''}
      verses={pericope.verses}
      color={pericope.color}
      accentColor={pericope.accentColor}
      verseData={verseData}
      image={pericope.image}
      imageAlt={pericope.imageAlt || ''}
      media={pericope.media || {}}
      exegesis={pericope.exegesis}
      lang="en"
      chapter={chapter}
      isFirst={true}
      layoutIndex={0}
    />
  </div>

  <!-- Prev/next navigation -->
  <nav class="pericope-nav">
    {prevPericope ? (
      <a href={`${base}/en/luke/${prevPericope.chapter}/${prevPericope.id}`} class="pericope-nav-btn pericope-nav-prev">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        <div class="pericope-nav-label">
          <span class="pericope-nav-meta">Luke {prevPericope.chapter}:{prevPericope.verses}</span>
          <span class="pericope-nav-title">{prevPericope.title}</span>
        </div>
      </a>
    ) : <div />}
    {nextPericope ? (
      <a href={`${base}/en/luke/${nextPericope.chapter}/${nextPericope.id}`} class="pericope-nav-btn pericope-nav-next">
        <div class="pericope-nav-label pericope-nav-label-right">
          <span class="pericope-nav-meta">Luke {nextPericope.chapter}:{nextPericope.verses}</span>
          <span class="pericope-nav-title">{nextPericope.title}</span>
        </div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    ) : <div />}
  </nav>

</BaseLayout>

<style>
  .pericope-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-family: 'Switzer', sans-serif;
    font-size: 0.85rem;
    color: var(--color-warm-gray);
    border-bottom: 1px solid var(--color-border);
  }
  .pericope-breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .pericope-breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb-sep { opacity: 0.4; }
  .breadcrumb-ref {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    opacity: 0.7;
  }

  .pericope-hero {
    position: relative;
    height: 50vh;
    min-height: 300px;
    max-height: 500px;
    overflow: hidden;
  }
  .pericope-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
  }
  .pericope-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 100%);
    color: white;
  }
  .pericope-hero-ref {
    font-family: 'Switzer', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  .pericope-hero-title {
    font-family: 'Softcore', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 150;
    line-height: 1.1;
    color: white;
  }

  .pericope-content-wrapper {
    /* PericopeCard handles its own styling */
  }

  /* Prev/next navigation */
  .pericope-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 3rem 2rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-paper);
  }
  .pericope-nav-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--color-charcoal);
    background: white;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
    max-width: 45%;
    flex: 1;
  }
  .pericope-nav-btn:hover {
    border-color: var(--color-accent);
    background: var(--color-cream);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }
  .pericope-nav-next { flex-direction: row-reverse; }
  .pericope-nav-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .pericope-nav-label-right { text-align: right; }
  .pericope-nav-meta {
    font-family: 'Switzer', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.7;
  }
  .pericope-nav-title {
    font-family: 'Softcore', Georgia, serif;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-charcoal);
  }

  @media (max-width: 640px) {
    .pericope-breadcrumb { padding: 0.75rem 1rem; }
    .pericope-nav { padding: 2rem 1rem; }
    .pericope-nav-btn { padding: 0.75rem 1rem; }
    .pericope-nav-title { font-size: 0.875rem; }
  }
</style>

<script is:inline>
(function() {
  function initFootnotePopovers() {
    document.querySelectorAll('.fn-btn').forEach(function(btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        var targetId = btn.getAttribute('data-fn-id');
        var popover = document.getElementById(targetId);
        document.querySelectorAll('.fn-popover, .fn-popover-mobile').forEach(function(p) {
          if (p.id !== targetId) p.classList.add('hidden');
        });
        if (popover && popover.classList.contains('hidden')) {
          var rect = btn.getBoundingClientRect();
          var scrollY = window.scrollY;
          var top = rect.bottom + scrollY + 8;
          var left = rect.left;
          if (left + 320 > window.innerWidth) left = window.innerWidth - 340;
          if (left < 20) left = 20;
          popover.style.top = top + 'px';
          popover.style.left = left + 'px';
          popover.classList.remove('hidden');
        } else if (popover) {
          popover.classList.add('hidden');
        }
      };
    });
    document.querySelectorAll('.mobile-fn-btn').forEach(function(btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        var targetId = btn.getAttribute('data-fn-id');
        var popover = document.getElementById(targetId);
        document.querySelectorAll('.fn-popover, .fn-popover-mobile').forEach(function(p) {
          if (p.id !== targetId) p.classList.add('hidden');
        });
        if (popover) popover.classList.toggle('hidden');
      };
    });
    document.querySelectorAll('.fn-close').forEach(function(btn) {
      btn.onclick = function(e) {
        e.preventDefault();
        e.stopPropagation();
        var popover = btn.closest('.fn-popover, .fn-popover-mobile');
        if (popover) popover.classList.add('hidden');
      };
    });
  }
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.fn-popover') && !e.target.closest('.fn-popover-mobile') && !e.target.closest('.fn-btn') && !e.target.closest('.mobile-fn-btn')) {
      document.querySelectorAll('.fn-popover, .fn-popover-mobile').forEach(function(p) { p.classList.add('hidden'); });
    }
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.fn-popover, .fn-popover-mobile').forEach(function(p) { p.classList.add('hidden'); });
    }
  });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFootnotePopovers);
  } else {
    initFootnotePopovers();
  }
})();
</script>
