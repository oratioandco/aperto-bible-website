---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import pericopes from '../../../content/luke-24-pericopes-en.json';

const base = '';
---

<BaseLayout title="Luke 24" lang="en" description="Luke Chapter 24">
  <!-- Chapter Header -->
  <header class="chapter-header">
    <p class="passage-reference">The Gospel of Luke</p>
    <h1 class="headline-mixed">
      <span class="cap">C</span>hapter 24
    </h1>
    <p class="chapter-subtitle">The empty tomb. The road to Emmaus. Appearances and ascension.</p>
    <ChapterNav currentChapter={24} lang="en" />
  </header>

  <!-- Pericope Grid -->
  <section class="pericope-grid-section">
    <div class="pericope-grid">
      {pericopes.pericopes.map((p) => (
        <a href={`${base}/en/luke/24/${p.id}`} class="pericope-thumb">
          {p.image && (
            <div class="pericope-thumb-img-wrap">
              <img src={`/images/luke/24/${p.image}`} alt={p.imageAlt || p.title} class="pericope-thumb-img" />
            </div>
          )}
          <div class="pericope-thumb-info" style={`background-color: ${p.color};`}>
            <span class="pericope-thumb-verses">{p.verses}</span>
            <span class="pericope-thumb-title">{p.title}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <footer class="chapter-footer">
    <ChapterNav currentChapter={24} lang="en" />
    <p class="mt-12 text-sm" style="color: var(--color-warm-gray);">
      Translation: Aperto Bible (AB-EN) | License: CC BY-SA 4.0
    </p>
  </footer>
</BaseLayout>

<style>
  .chapter-header {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(180deg, #FFFBF5 0%, #F5EBE0 100%);
  }
  .chapter-subtitle {
    font-family: 'Switzer', sans-serif;
    font-size: 1.1rem;
    color: var(--color-warm-gray);
    max-width: 36rem;
    margin-bottom: 2rem;
  }
  .headline-mixed {
    font-family: 'Softcore', Georgia, serif;
    font-size: clamp(3rem, 8vw, 6rem);
    color: #6B5A4A;
    margin-bottom: 1rem;
  }
  .headline-mixed .cap {
    font-family: 'Silvera', serif;
    color: #9A8570;
    font-size: 1.1em;
  }
  .pericope-grid-section {
    padding: 3rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .pericope-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .pericope-thumb {
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--color-border);
    transition: all 0.25s ease;
    display: block;
  }
  .pericope-thumb:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }
  .pericope-thumb-img-wrap {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .pericope-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pericope-thumb:hover .pericope-thumb-img {
    transform: scale(1.04);
  }
  .pericope-thumb-info {
    padding: 1rem 1.25rem;
  }
  .pericope-thumb-verses {
    display: block;
    font-family: 'Switzer', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-warm-gray);
    margin-bottom: 0.35rem;
  }
  .pericope-thumb-title {
    display: block;
    font-family: 'Softcore', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 150;
    color: var(--color-charcoal);
    line-height: 1.3;
  }
  .chapter-footer {
    padding: 3rem 2rem;
    text-align: center;
    background: #F5E6DC;
  }
</style>
