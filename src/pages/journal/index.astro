---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../lib/journal';

const modules = import.meta.glob('../../content/journal/*.md', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const posts = loadPosts(modules as Record<string, string>);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Journal" description="Notes from the workshop: how an exegesis-grounded, AI-drafted, human-decided Bible translation actually gets made." lang="en">
  <article class="journal">
    <h1>Journal</h1>
    <p class="journal-intro">
      Notes from the workshop — how an exegesis-grounded, AI-drafted, human-decided
      Bible translation actually gets made. Written by
      <a href="/en/about">Tobias Treppmann</a>. English first; the translation itself
      speaks <a href="/de/">German</a>, <a href="/en/">English</a>, and <a href="/pl/">Polish</a>.
    </p>

    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a class="post-card" href={`/journal/${p.slug}/`}>
            {p.cover && (
              <img class="post-cover" src={p.cover} alt={p.coverAlt ?? ''} loading="lazy" />
            )}
            <span class="post-body">
              <span class="post-date">{fmt(p.date)}</span>
              <span class="post-title">{p.title}</span>
              <span class="post-desc">{p.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .journal { max-width: 46rem; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  h1 {
    font-family: 'Fraunces', Georgia, serif; font-size: clamp(2.4rem, 6vw, 3.4rem);
    line-height: 1.08; color: #2C2C2C; margin: 0 0 1.25rem;
  }
  .journal-intro {
    font-family: 'Switzer', sans-serif; font-size: 1.1rem; line-height: 1.7;
    color: #5A5A5A; margin: 0 0 3rem;
  }
  .journal-intro a { color: #8B7355; text-decoration: underline; text-underline-offset: 2px; }
  .post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .post-card {
    display: block; border: 1px solid rgba(139, 115, 85, 0.2);
    border-radius: 10px; background: #FFFBF5; text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .post-cover { display: block; width: 100%; aspect-ratio: 16 / 7; object-fit: cover; }
  .post-body { display: block; padding: 1.5rem 1.75rem; }
  .post-card:hover { box-shadow: 0 2px 12px rgba(44, 44, 44, 0.07); border-color: rgba(139, 115, 85, 0.45); }
  .post-date {
    display: block; font-family: 'Switzer', sans-serif; font-size: 0.8rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: #8B7355; margin-bottom: 0.35rem;
  }
  .post-title {
    display: block; font-family: 'Fraunces', Georgia, serif; font-size: 1.45rem;
    line-height: 1.25; color: #2C2C2C; margin-bottom: 0.4rem;
  }
  .post-desc { display: block; font-family: 'Switzer', sans-serif; font-size: 0.98rem; line-height: 1.6; color: #5A5A5A; }
</style>
