---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPosts } from '../../lib/journal';

export function getStaticPaths() {
  const modules = import.meta.glob('../../content/journal/*.md', {
    eager: true,
    query: '?raw',
    import: 'default',
  });
  // Re-derive inside getStaticPaths (Astro requires self-contained closures)
  const parse = (path: string, raw: string) => {
    const slug = path.split('/').pop()!.replace(/\.md$/, '');
    const m = raw.match(/^---\n([\s\S]*?)\n---\n?/);
    const meta: Record<string, string> = {};
    if (m) for (const line of m[1].split('\n')) {
      const i = line.indexOf(':');
      if (i > 0) meta[line.slice(0, i).trim()] = line.slice(i + 1).trim();
    }
    return { slug, meta, body: m ? raw.slice(m[0].length) : raw };
  };
  return Object.entries(modules).map(([path, raw]) => {
    const p = parse(path, raw as string);
    return { params: { slug: p.slug }, props: { meta: p.meta, body: p.body } };
  });
}

const { meta, body } = Astro.props as { meta: Record<string, string>; body: string };
marked.setOptions({ gfm: true, breaks: false });
const html = marked.parse(body);
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={meta.title} description={meta.description} lang="en">
  <article class="journal-post">
    <p class="post-meta">
      <a href="/journal/">Journal</a> · {fmt(meta.date)} · {meta.author}
    </p>
    <h1>{meta.title}</h1>
    <p class="post-lead">{meta.description}</p>
    <div class="prose" set:html={html} />

    <div class="post-footer">
      <a class="footer-link" href="/journal/">← Journal</a>
      <a class="footer-cta" href="/en/methodology">The methodology</a>
    </div>
  </article>
</BaseLayout>

<style>
  .journal-post { max-width: 46rem; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  .post-meta {
    font-family: 'Switzer', sans-serif; font-size: 0.85rem; letter-spacing: 0.04em;
    color: #8B7355; margin: 0 0 1rem;
  }
  .post-meta a { color: #8B7355; text-decoration: underline; text-underline-offset: 2px; }
  h1 {
    font-family: 'Fraunces', Georgia, serif; font-size: clamp(2.2rem, 5.5vw, 3.1rem);
    line-height: 1.1; color: #2C2C2C; margin: 0 0 1rem;
  }
  .post-lead {
    font-family: 'Switzer', sans-serif; font-size: 1.18rem; line-height: 1.65;
    color: #5A5A5A; margin: 0 0 2.5rem;
  }
  .prose { font-family: 'Switzer', sans-serif; font-size: 1.06rem; line-height: 1.75; color: #4A4A4A; }
  :global(.journal-post .prose p) { margin: 0 0 1.25rem; }
  :global(.journal-post .prose strong) { color: #2C2C2C; font-weight: 600; }
  :global(.journal-post .prose em) { font-style: italic; }
  :global(.journal-post .prose a) { color: #8B7355; text-decoration: underline; text-underline-offset: 2px; }
  :global(.journal-post .prose a:hover) { opacity: 0.75; }
  :global(.journal-post .prose blockquote) {
    margin: 1.75rem 0; padding: 1rem 1.25rem; border-left: 3px solid #8B7355;
    background: rgba(139, 115, 85, 0.06); border-radius: 0 8px 8px 0; color: #5A5A5A;
  }
  .post-footer {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #F0E4D8;
  }
  .footer-link { font-family: 'Switzer', sans-serif; color: #8B7355; text-decoration: none; }
  .footer-link:hover { opacity: 0.75; }
  .footer-cta {
    display: inline-block; padding: 0.85rem 1.75rem; border-radius: 6px; font-weight: 500;
    background-color: #8B7355; color: #FFFBF5; text-decoration: none;
    font-family: 'Switzer', sans-serif;
  }
  .footer-cta:hover { opacity: 0.9; }
</style>
