---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { marked } from 'marked';

// ---------------------------------------------------------------------------
// Load intro markdown for all languages (Psalms book intro)
// ---------------------------------------------------------------------------
const introModules = import.meta.glob('../../../content/introductions-psalms/*.md', {
  eager: true,
  query: '?raw',
  import: 'default',
});

function getIntroHtml(lang: string): string {
  const key = Object.keys(introModules).find(k => k.endsWith(`/${lang}.md`));
  const enKey = Object.keys(introModules).find(k => k.endsWith('/en.md'));
  const raw = (key ? introModules[key] : (enKey ? introModules[enKey] : '')) as string;
  return raw ? String(marked(raw)) : '';
}

// ---------------------------------------------------------------------------
// Load all pericope metadata
// ---------------------------------------------------------------------------
const allMetaModules = import.meta.glob('../../../content/psalms-*-pericopes-*.json', { eager: true });

function parseMeta(path: string) {
  const m = path.match(/psalms-(\d+)-pericopes-([a-z]+)\.json$/);
  return m ? { chapter: parseInt(m[1]), lang: m[2] } : null;
}

const metaByLangChapter: Record<string, Record<number, any>> = {};
for (const [path, mod] of Object.entries(allMetaModules)) {
  const p = parseMeta(path);
  if (!p) continue;
  if (!metaByLangChapter[p.lang]) metaByLangChapter[p.lang] = {};
  metaByLangChapter[p.lang][p.chapter] = (mod as any).default ?? mod;
}

// ---------------------------------------------------------------------------
// getStaticPaths — one page per (lang, chapter)
// (We omit the chapter:undefined base because static index pages
//  at /{lang}/psalms/index.astro already serve the book intro for de/en/pl.)
// ---------------------------------------------------------------------------
export function getStaticPaths() {
  const mods = import.meta.glob('../../../content/psalms-*-pericopes-*.json', { eager: true });
  const langChapters: Record<string, Set<number>> = {};
  for (const path of Object.keys(mods)) {
    const m = path.match(/psalms-(\d+)-pericopes-([a-z]+)\.json$/);
    if (!m) continue;
    const ch = parseInt(m[1], 10);
    const lg = m[2];
    if (!langChapters[lg]) langChapters[lg] = new Set();
    langChapters[lg].add(ch);
  }

  // Languages that already have a static /{lang}/psalms/index.astro page
  // serving the book intro. Skip emitting chapter:undefined for these to
  // avoid duplicate-route collisions.
  const langsWithStaticIntro = new Set(['de', 'en', 'pl']);

  const paths: any[] = [];
  for (const lg of Object.keys(langChapters)) {
    if (!langsWithStaticIntro.has(lg)) {
      // Base URL: /{lang}/psalms/
      paths.push({ params: { lang: lg, chapter: undefined }, props: { lang: lg, chapter: null } });
    }
    // Per-chapter URL: /{lang}/psalms/{n}
    for (const ch of langChapters[lg]) {
      paths.push({ params: { lang: lg, chapter: String(ch) }, props: { lang: lg, chapter: ch } });
    }
  }
  return paths;
}

// ---------------------------------------------------------------------------
// Page data
// ---------------------------------------------------------------------------
const { lang, chapter: initialChapter } = Astro.props as { lang: string; chapter: number | null };

const bookNameMap: Record<string, string> = {
  de: 'Psalmen', en: 'Psalms', pl: 'Psalmy', fr: 'Psaumes', es: 'Salmos',
  it: 'Salmi', pt: 'Salmos', nl: 'Psalmen', da: 'Salmernes Bog',
  sv: 'Psaltaren', nb: 'Salmenes bok',
};
const bookName = bookNameMap[lang] ?? 'Psalms';

const chapWordMap: Record<string, string> = {
  ar: 'الفصل', bg: 'Глава', ca: 'Capítol', cs: 'Kapitola', da: 'Kapitel',
  de: 'Psalm', el: 'Ψαλμός', es: 'Salmo', et: 'Peatükk', fi: 'Psalmi',
  fr: 'Psaume', ga: 'Salm', hr: 'Psalam', hu: 'Zsoltár', it: 'Salmo',
  lt: 'Psalmė', lv: 'Psalms', mt: 'Salm', nb: 'Salme', nl: 'Psalm',
  pl: 'Psalm', pt: 'Salmo', ro: 'Psalm', ru: 'Псалом', sk: 'Žalm',
  sl: 'Psalm', sq: 'Psalmi', sv: 'Psalm', tr: 'Mezmur', uk: 'Псалом',
  en: 'Psalm',
};
const chapWord = chapWordMap[lang] ?? 'Psalm';

const introLabelMap: Record<string, string> = {
  de: 'Einleitung', fr: 'Introduction', es: 'Introducción', pl: 'Wstęp',
  it: 'Introduzione', pt: 'Introdução', nl: 'Inleiding', ru: 'Введение',
  uk: 'Вступ', ar: 'مقدمة', tr: 'Giriş',
};
const introLabel = introLabelMap[lang] ?? 'Introduction';

const bookLabelMap: Record<string, string> = {
  de: 'Das Buch der Psalmen', en: 'The Book of Psalms', pl: 'Księga Psalmów',
  fr: 'Le Livre des Psaumes', es: 'El Libro de los Salmos',
  it: 'Il Libro dei Salmi', pt: 'O Livro dos Salmos',
  nl: 'Het Boek der Psalmen', da: 'Salmernes Bog',
  sv: 'Psaltaren', nb: 'Salmenes bok',
};
const bookLabel = bookLabelMap[lang] ?? 'The Book of Psalms';

// ---------------------------------------------------------------------------
// Book switcher — discover which other books have intros for this language
// ---------------------------------------------------------------------------
const lukeIntroMods = import.meta.glob('../../../content/introductions/*.md', { eager: true });
const hasLuke = Object.keys(lukeIntroMods).some(k => k.endsWith(`/${lang}.md`));

const actsIntroMods = import.meta.glob('../../../content/introductions-acts/*.md', { eager: true });
const hasActs = Object.keys(actsIntroMods).some(k => k.endsWith(`/${lang}.md`));

const lukeBookLabels: Record<string, { name: string; label: string }> = {
  ar: { name: 'لوقا', label: 'إنجيل لوقا' },
  bg: { name: 'Лука', label: 'Евангелие от Лука' },
  ca: { name: 'Lluc', label: "L'Evangeli segons Lluc" },
  cs: { name: 'Lukáš', label: 'Evangelium podle Lukáše' },
  da: { name: 'Lukas', label: 'Lukasevangeliet' },
  de: { name: 'Lukas', label: 'Das Evangelium nach Lukas' },
  el: { name: 'Λουκάς', label: 'Κατά Λουκάν' },
  en: { name: 'Luke', label: 'The Gospel of Luke' },
  es: { name: 'Lucas', label: 'El Evangelio según Lucas' },
  fr: { name: 'Luc', label: "L'Évangile selon Luc" },
  it: { name: 'Luca', label: 'Il Vangelo secondo Luca' },
  nb: { name: 'Lukas', label: 'Lukasevangeliet' },
  nl: { name: 'Lucas', label: 'Het Evangelie volgens Lucas' },
  pl: { name: 'Łukasz', label: 'Ewangelia według Łukasza' },
  pt: { name: 'Lucas', label: 'O Evangelho segundo Lucas' },
  sv: { name: 'Lukas', label: 'Lukasevangeliet' },
};

const actsBookLabels: Record<string, { name: string; label: string }> = {
  de: { name: 'Apostelgeschichte', label: 'Die Apostelgeschichte' },
  en: { name: 'Acts', label: 'The Acts of the Apostles' },
  pl: { name: 'Dzieje Apostolskie', label: 'Dzieje Apostolskie' },
  fr: { name: 'Actes', label: 'Les Actes des Apôtres' },
  es: { name: 'Hechos', label: 'Los Hechos de los Apóstoles' },
  it: { name: 'Atti', label: 'Atti degli Apostoli' },
  pt: { name: 'Atos', label: 'Atos dos Apóstolos' },
  nl: { name: 'Handelingen', label: 'Handelingen van de Apostelen' },
  da: { name: 'Apostlenes Gerninger', label: 'Apostlenes Gerninger' },
  sv: { name: 'Apostlagärningarna', label: 'Apostlagärningarna' },
  nb: { name: 'Apostlenes gjerninger', label: 'Apostlenes gjerninger' },
};

const booksAllLabel: Record<string, string> = {
  de: 'Bücher', en: 'Books', pl: 'Księgi',
};
const booksLabel = booksAllLabel[lang] ?? 'Books';

type BookEntry = { id: string; name: string; label: string; active: boolean };
const booksInLang: BookEntry[] = [
  ...(hasLuke && lukeBookLabels[lang]
    ? [{ id: 'luke', ...lukeBookLabels[lang], active: false }]
    : []),
  { id: 'psalms', name: bookName, label: bookLabel, active: true },
  ...(hasActs && actsBookLabels[lang]
    ? [{ id: 'acts', ...actsBookLabels[lang], active: false }]
    : []),
];
const hasMultipleBooks = booksInLang.length > 1;

// ── Chapter labels (no labels JSON for Psalms; just use "Psalm N") ─────────
// Psalms range: 1–150
const PSALM_MIN = 1;
const PSALM_MAX = 150;

const chapterLabels: Record<number, string> = {};
for (let ch = PSALM_MIN; ch <= PSALM_MAX; ch++) {
  chapterLabels[ch] = '';
}

// Native-availability map: which chapters exist in THIS language's own files.
const hasNativeChapter: Record<number, boolean> = {};
for (let ch = PSALM_MIN; ch <= PSALM_MAX; ch++) {
  hasNativeChapter[ch] = !!metaByLangChapter[lang]?.[ch]?.pericopes?.length;
}

// Compact pericope data for JS
const chaptersData: Record<number, { title: string; ref: string; pericopes: any[] }> = {};
for (let ch = PSALM_MIN; ch <= PSALM_MAX; ch++) {
  const data = metaByLangChapter[lang]?.[ch] ?? metaByLangChapter['en']?.[ch];
  if (!data?.pericopes?.length) continue;
  chaptersData[ch] = {
    title: `${chapWord} ${ch}`,
    ref: `${bookName} ${ch}`,
    pericopes: data.pericopes.map((p: any) => ({
      id: p.id,
      title: p.title,
      verses: p.verses,
      image: p.image || null,
      imageAlt: p.imageAlt || '',
      color: p.color || '#E8D5C0',
    })),
  };
}

// Single flat section — all available chapters in one list.
const availableChapters = Object.keys(chaptersData).map(n => parseInt(n, 10)).sort((a, b) => a - b);
const narrativeSections = [
  {
    title: bookLabel,
    subtitle: availableChapters.length
      ? `${chapWord} ${availableChapters.join(', ')}`
      : '',
    chapters: availableChapters,
  },
];

const introHtml = getIntroHtml(lang);
---

<BaseLayout title={`${bookName} — ${bookLabel}`} lang={lang} description={bookLabel}>
  <div class="book-page">

    <!-- Master panel -->
    <aside class="book-master" id="book-master">

      {hasMultipleBooks ? (
        <button class="master-book-title master-book-title-btn" id="book-switcher-btn" aria-expanded="false" aria-controls="master-books-view">
          <div class="master-book-title-text">
            <p class="master-gospel-label">{bookLabel}</p>
            <h1 class="master-book-name">{bookName}</h1>
          </div>
          <svg class="master-book-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      ) : (
        <div class="master-book-title">
          <p class="master-gospel-label">{bookLabel}</p>
          <h1 class="master-book-name">{bookName}</h1>
        </div>
      )}

      {hasMultipleBooks && (
        <div class="master-books-view" id="master-books-view" hidden>
          <p class="master-books-label">{booksLabel}</p>
          {booksInLang.map(b => (
            <a href={`/${lang}/${b.id}/`} class:list={["master-book-item", b.active && "is-active"]}>
              <span class="master-book-item-icon material-symbols-rounded">menu_book</span>
              <span class="master-book-item-text">
                <span class="master-book-item-name">{b.name}</span>
                <span class="master-book-item-label">{b.label}</span>
              </span>
            </a>
          ))}
        </div>
      )}

      <div class="master-chapters-view" id="master-chapters-view">
        <!-- Introduction entry -->
        <button class:list={["master-item", "master-intro-btn", !initialChapter && "is-active"]} data-panel="intro" id="intro-btn">
          <span class="master-item-icon material-symbols-rounded">menu_book</span>
          <span class="master-item-label">{introLabel}</span>
        </button>

        <!-- Narrative sections -->
        {narrativeSections.map(section => (
          <div class="master-section">
            <div class="master-section-header">
              <span class="master-section-title">{section.title}</span>
              <span class="master-section-sub">{section.subtitle}</span>
            </div>
            {section.chapters.map(ch => {
              const available = hasNativeChapter[ch];
              return available ? (
                <button
                  class:list={["master-item", "master-chapter-btn", initialChapter === ch && "is-active"]}
                  data-panel={`ch-${ch}`}
                  data-chapter={ch}
                >
                  <span class="master-ch-num">{ch}</span>
                  <span class="master-ch-label">{chapterLabels[ch] ?? ''}</span>
                  <svg class="master-ch-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              ) : (
                <div class="master-item master-chapter-btn is-disabled" aria-disabled="true">
                  <span class="master-ch-num">{ch}</span>
                  <span class="master-ch-label">{chapterLabels[ch] ?? ''}</span>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </aside>

    <!-- Detail panel -->
    <main class="book-detail" id="book-detail">

      <!-- Introduction panel -->
      <div class:list={["detail-panel", initialChapter && "is-hidden"]} id="panel-intro">
        <header class="intro-detail-header">
          <p class="passage-reference">{bookLabel}</p>
          <h1 class="headline-mixed">
            {bookName}
          </h1>
          <p class="intro-detail-subtitle">{introLabel}</p>
        </header>
        <div class="intro-content">
          <figure class="intro-cover">
            <img
              src="/images/psalms/cover.png"
              alt={bookLabel}
              loading="eager"
            />
          </figure>
          <article class="intro-prose" set:html={introHtml} />
          {availableChapters.length > 0 && (
            <div class="intro-cta">
              <a href={`/${lang}/psalms/${availableChapters[0]}`} class="intro-cta-btn">
                {chapWord} {availableChapters[0]}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Chapter pericope panel (JS-rendered) -->
      <div class:list={["detail-panel", !initialChapter && "is-hidden"]} id="panel-chapter">
        <div class="chapter-detail-header" id="chapter-detail-header"></div>
        <div class="pericope-card-grid" id="pericope-card-grid"></div>
      </div>

    </main>
  </div>
</BaseLayout>

<style>
  /* ── Two-panel layout ── */
  .book-page {
    display: flex;
    height: calc(100vh - 60px);
    overflow: hidden;
  }

  /* ── Master panel ── */
  .book-master {
    width: 272px;
    flex-shrink: 0;
    overflow-y: auto;
    border-right: 1px solid rgba(139, 115, 85, 0.14);
    background: var(--color-paper, #FFFBF5);
    display: flex;
    flex-direction: column;
  }

  .master-book-title {
    padding: 1.5rem 1rem 1rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
  }
  .master-book-title-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.12s ease;
    font-family: inherit;
  }
  .master-book-title-btn:hover {
    background: rgba(139, 115, 85, 0.05);
  }
  .master-book-title-text {
    flex: 1;
    min-width: 0;
  }
  .master-book-chevron {
    flex-shrink: 0;
    color: var(--color-accent, #8B7355);
    transition: transform 0.18s ease;
  }
  .master-book-title-btn[aria-expanded="true"] .master-book-chevron {
    transform: rotate(180deg);
  }
  .master-gospel-label {
    font-family: 'Switzer', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
    margin-bottom: 0.25rem;
  }
  .master-book-name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 150;
    color: var(--color-charcoal, #3D3530);
    line-height: 1.1;
  }

  /* ── Books view (shown when switcher is open) ── */
  .master-books-view {
    padding: 0.75rem 0.625rem 0.5rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
  }
  .master-books-label {
    font-family: 'Switzer', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
    padding: 0.35rem 0.5rem 0.4rem;
  }
  .master-book-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.12s ease;
  }
  .master-book-item:hover { background: rgba(139, 115, 85, 0.08); }
  .master-book-item.is-active { background: rgba(139, 115, 85, 0.12); }
  .master-book-item-icon {
    font-size: 1.1rem;
    color: var(--color-accent, #8B7355);
    flex-shrink: 0;
  }
  .master-book-item-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .master-book-item-name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-charcoal, #3D3530);
    line-height: 1.2;
  }
  .master-book-item.is-active .master-book-item-name {
    color: var(--color-accent, #8B7355);
    font-weight: 600;
  }
  .master-book-item-label {
    font-family: 'Switzer', sans-serif;
    font-size: 0.7rem;
    color: var(--color-warm-gray, #9A8A7A);
    margin-top: 0.1rem;
  }

  /* Books-mode: hide chapter list */
  .book-master.is-books-mode #master-chapters-view {
    display: none;
  }

  /* Master items */
  .master-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: background 0.12s ease;
    font-family: 'Switzer', sans-serif;
  }
  .master-item:hover { background: rgba(139, 115, 85, 0.07); }
  .master-item.is-active {
    background: rgba(139, 115, 85, 0.12);
  }
  .master-item.is-active .master-item-label,
  .master-item.is-active .master-ch-label {
    color: var(--color-accent, #8B7355);
    font-weight: 600;
  }

  .master-intro-btn {
    margin: 0.5rem 0.625rem;
    width: calc(100% - 1.25rem);
    border: 1px solid transparent;
  }
  .master-intro-btn.is-active {
    border-color: rgba(139, 115, 85, 0.2);
  }
  .master-item-icon {
    font-size: 1.05rem;
    color: var(--color-accent, #8B7355);
    flex-shrink: 0;
  }
  .master-item-label {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--color-charcoal, #3D3530);
  }

  /* Narrative sections */
  .master-section {
    padding: 0 0.625rem 0.25rem;
    border-top: 1px solid rgba(139, 115, 85, 0.08);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
  }
  .master-section-header {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.375rem 0.25rem;
  }
  .master-section-title {
    font-family: 'Switzer', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
  }
  .master-section-sub {
    font-family: 'Switzer', sans-serif;
    font-size: 0.65rem;
    color: var(--color-warm-gray, #9A8A7A);
  }

  .master-chapter-btn {
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
  }
  .master-ch-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: rgba(139, 115, 85, 0.1);
    font-family: 'Switzer', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-charcoal, #3D3530);
    flex-shrink: 0;
  }
  .master-item.is-active .master-ch-num {
    background: var(--color-accent, #8B7355);
    color: white;
  }
  .master-ch-label {
    font-size: 0.775rem;
    color: var(--color-charcoal, #3D3530);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .master-ch-arrow {
    flex-shrink: 0;
    opacity: 0;
    color: var(--color-accent, #8B7355);
    transition: opacity 0.1s ease;
  }
  .master-chapter-btn:hover .master-ch-arrow,
  .master-chapter-btn.is-active .master-ch-arrow { opacity: 0.5; }

  /* Disabled chapter (not yet available for this language) */
  .master-chapter-btn.is-disabled {
    cursor: default;
    opacity: 0.42;
  }
  .master-chapter-btn.is-disabled:hover { background: transparent; }
  .master-chapter-btn.is-disabled .master-ch-num {
    background: rgba(139, 115, 85, 0.06);
    color: var(--color-warm-gray, #9A8A7A);
  }
  .master-chapter-btn.is-disabled .master-ch-label {
    color: var(--color-warm-gray, #9A8A7A);
  }

  /* ── Detail panel ── */
  .book-detail {
    flex: 1;
    overflow-y: auto;
    min-width: 0;
    background: var(--color-cream, #FAF5EE);
  }

  .detail-panel { width: 100%; }
  .detail-panel.is-hidden { display: none; }

  /* Introduction detail */
  .intro-detail-header {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 2.5rem 1.5rem;
    text-align: left;
    border-bottom: 1px solid rgba(139, 115, 85, 0.12);
  }
  .intro-detail-header .passage-reference {
    font-family: 'Switzer', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
    margin-bottom: 0.6rem;
  }
  .intro-detail-header .headline-mixed {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.05;
    margin-bottom: 0.5rem;
  }
  .intro-detail-subtitle {
    font-family: 'Switzer', sans-serif;
    font-size: 0.95rem;
    color: var(--color-warm-gray, #9A8A7A);
    letter-spacing: 0.02em;
  }
  .intro-content {
    max-width: 680px;
    margin: 0 auto;
    padding: 2.25rem 2.5rem 5rem;
  }
  .intro-cover {
    margin: 0 0 2.5rem;
  }
  .intro-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .intro-prose {
    font-family: 'Switzer', sans-serif;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text, #3C3530);
  }
  :global(.intro-prose h1) { display: none; }
  :global(.intro-prose h2) {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 150;
    color: var(--color-charcoal, #3D3530);
    margin-top: 2.5rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.12);
    padding-bottom: 0.4rem;
  }
  :global(.intro-prose p) { margin-bottom: 1.15rem; }
  :global(.intro-prose em) { font-style: italic; color: #5C4F45; }

  .intro-cta {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(139, 115, 85, 0.15);
  }
  .intro-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: 9999px;
    background: var(--color-accent, #8B7355);
    color: white;
    font-family: 'Switzer', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.18s ease;
  }
  .intro-cta-btn:hover { opacity: 0.85; }

  /* Chapter pericope grid */
  .chapter-detail-header {
    padding: 2rem 2rem 1rem;
    border-bottom: 1px solid rgba(139, 115, 85, 0.1);
  }
  :global(.chapter-detail-ref) {
    font-family: 'Switzer', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
    margin-bottom: 0.4rem;
  }
  .chapter-detail-header h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 150;
    color: var(--color-charcoal, #3D3530);
    margin-bottom: 0.25rem;
    line-height: 1.1;
  }
  .chapter-detail-header a {
    font-family: 'Switzer', sans-serif;
    font-size: 0.78rem;
    color: var(--color-accent, #8B7355);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .chapter-detail-header a:hover { text-decoration: underline; }

  .pericope-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.125rem;
    padding: 1.5rem 2rem 4rem;
    align-items: stretch;
  }
  :global(.book-pericope-thumb) {
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(139, 115, 85, 0.15);
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    display: flex;
    flex-direction: column;
    background: white;
  }
  :global(.book-pericope-thumb:hover) {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
  }
  :global(.book-pericope-img-wrap) {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }
  :global(.book-pericope-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    display: block;
  }
  :global(.book-pericope-thumb:hover .book-pericope-img) { transform: scale(1.04); }
  :global(.book-pericope-info) {
    padding: 0.875rem 1rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: 64px;
  }
  :global(.book-pericope-verses) {
    display: block;
    font-family: 'Switzer', sans-serif;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-warm-gray, #9A8A7A);
    margin-bottom: 0.25rem;
  }
  :global(.book-pericope-title) {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 0.975rem;
    font-weight: 150;
    color: var(--color-charcoal, #3D3530);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Mobile: stacked layout ── */
  @media (max-width: 768px) {
    .book-page {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }
    .book-master {
      width: 100%;
      height: auto;
      overflow: visible;
      border-right: none;
      border-bottom: 1px solid rgba(139, 115, 85, 0.14);
      max-height: 300px;
      overflow-y: auto;
    }
    .book-detail {
      overflow: visible;
    }
    .pericope-card-grid { padding: 1rem 1rem 3rem; gap: 0.875rem; }
    .intro-detail-header { padding: 2rem 1.25rem 1rem; }
    .intro-content { padding: 1.5rem 1.25rem 3rem; }
    .chapter-detail-header { padding: 1.25rem 1rem 0.75rem; }
  }
</style>

<script define:vars={{ chaptersData, lang, chapWord, initialChapter }}>
(function () {
  // Book switcher toggle (shown when multiple books are available)
  var switcherBtn = document.getElementById('book-switcher-btn');
  var booksView = document.getElementById('master-books-view');
  var masterAside = document.getElementById('book-master');
  if (switcherBtn && booksView && masterAside) {
    switcherBtn.addEventListener('click', function () {
      var isOpen = switcherBtn.getAttribute('aria-expanded') === 'true';
      switcherBtn.setAttribute('aria-expanded', String(!isOpen));
      masterAside.classList.toggle('is-books-mode', !isOpen);
      if (isOpen) {
        booksView.setAttribute('hidden', '');
      } else {
        booksView.removeAttribute('hidden');
      }
    });
  }

  var activePanel = initialChapter ? ('ch-' + initialChapter) : 'intro';

  var masterBtns = document.querySelectorAll('.master-item');
  var panelIntro = document.getElementById('panel-intro');
  var panelChapter = document.getElementById('panel-chapter');
  var gridContainer = document.getElementById('pericope-card-grid');
  var headerContainer = document.getElementById('chapter-detail-header');
  var detail = document.getElementById('book-detail');

  function escHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderChapter(ch) {
    var data = chaptersData[ch];
    if (!data) return;

    headerContainer.innerHTML =
      '<p class="chapter-detail-ref">' + escHtml(data.ref) + '</p>' +
      '<h2>' + escHtml(data.title) + '</h2>';

    var html = '';
    data.pericopes.forEach(function (p) {
      var href = '/' + lang + '/psalms/' + ch + '/' + p.id;
      html += '<a href="' + escHtml(href) + '" class="book-pericope-thumb">';
      if (p.image) {
        html += '<div class="book-pericope-img-wrap">'
          + '<img src="/images/psalms/' + ch + '/' + escHtml(p.image) + '" alt="' + escHtml(p.imageAlt || p.title) + '" class="book-pericope-img" loading="lazy">'
          + '</div>';
      }
      html += '<div class="book-pericope-info" style="background-color:' + escHtml(p.color) + '">'
        + '<span class="book-pericope-verses">' + escHtml(p.verses) + '</span>'
        + '<span class="book-pericope-title">' + escHtml(p.title) + '</span>'
        + '</div></a>';
    });
    gridContainer.innerHTML = html;
  }

  function setActive(panelId) {
    masterBtns.forEach(function (btn) {
      btn.classList.toggle('is-active', btn.getAttribute('data-panel') === panelId);
    });
  }

  function activate(panelId, pushUrl) {
    if (panelId === activePanel) return;
    activePanel = panelId;

    setActive(panelId);

    if (panelId === 'intro') {
      panelChapter.classList.add('is-hidden');
      panelIntro.classList.remove('is-hidden');
      if (pushUrl) history.pushState({ panel: 'intro' }, '', '/' + lang + '/psalms/');
    } else {
      var ch = parseInt(panelId.replace('ch-', ''), 10);
      renderChapter(ch);
      panelIntro.classList.add('is-hidden');
      panelChapter.classList.remove('is-hidden');
      if (pushUrl) history.pushState({ panel: panelId }, '', '/' + lang + '/psalms/' + ch);
    }

    if (detail) detail.scrollTop = 0;
  }

  // Render the chapter pre-selected on server if any
  if (initialChapter) renderChapter(initialChapter);

  masterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      activate(btn.getAttribute('data-panel'), true);
    });
  });

  window.addEventListener('popstate', function (e) {
    var m = location.pathname.match(/\/psalms\/(\d+)\/?$/);
    var target = m ? ('ch-' + m[1]) : 'intro';
    if (target !== activePanel) {
      activePanel = null;
      activate(target, false);
    }
  });
})();
</script>
