---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'da' } },
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'sv' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ro' } },
    { params: { lang: 'cs' } },
    { params: { lang: 'el' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'bg' } },
    { params: { lang: 'hr' } },
    { params: { lang: 'fi' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'lt' } },
    { params: { lang: 'sl' } },
    { params: { lang: 'lv' } },
    { params: { lang: 'et' } },
    { params: { lang: 'ga' } },
    { params: { lang: 'mt' } },
    { params: { lang: 'nb' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'ca' } },
    { params: { lang: 'sq' } },
  ];
}

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang);
---

<BaseLayout title={t('legal.imprint.title')} lang={lang}>
  <article class="py-16 md:py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl mb-12 headline-mixed">{t('legal.imprint.title')}</h1>

      <section class="mb-12">
        <h2 class="text-2xl md:text-3xl mb-4 headline-mixed">{t('legal.imprint.responsible.title')}</h2>
        <p class="text-lg leading-relaxed" style="color: #5A5A5A; white-space: pre-line;">
          {t('legal.imprint.responsible.text')}
        </p>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl md:text-3xl mb-4 headline-mixed">{t('legal.imprint.contact.title')}</h2>
        <p class="text-lg leading-relaxed" style="color: #5A5A5A; white-space: pre-line;">
          {t('legal.imprint.contact.text')}
        </p>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl md:text-3xl mb-4 headline-mixed">{t('legal.imprint.disclaimer.title')}</h2>
        <p class="text-lg leading-relaxed" style="color: #5A5A5A; white-space: pre-line;">
          {t('legal.imprint.disclaimer.text')}
        </p>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl md:text-3xl mb-4 headline-mixed">{t('legal.imprint.license.title')}</h2>
        <p class="text-lg leading-relaxed" style="color: #5A5A5A; white-space: pre-line;">
          {t('legal.imprint.license.text')}
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
