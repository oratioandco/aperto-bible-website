---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookNav from '../../../components/BookNav.astro';
import { useTranslations } from '../../../i18n/utils';

// ---------------------------------------------------------------------------
// Load all pericope metadata via import.meta.glob
// ---------------------------------------------------------------------------
const allMetaModules = import.meta.glob('../../../content/luke-*-pericopes-*.json', { eager: true });

function parseMeta(path: string) {
  const m = path.match(/luke-(\d+)-pericopes-([a-z]+)\.json$/);
  return m ? { chapter: parseInt(m[1]), lang: m[2] } : null;
}

const metaByLangChapter: Record<string, Record<number, any>> = {};
for (const [path, mod] of Object.entries(allMetaModules)) {
  const p = parseMeta(path);
  if (!p) continue;
  if (!metaByLangChapter[p.lang]) metaByLangChapter[p.lang] = {};
  metaByLangChapter[p.lang][p.chapter] = (mod as any).default ?? mod;
}

// ---------------------------------------------------------------------------
// getStaticPaths
// ---------------------------------------------------------------------------
export function getStaticPaths() {
  const metaModules = import.meta.glob('../../../content/luke-*-pericopes-*.json', { eager: true });

  function parseMeta(path: string) {
    const m = path.match(/luke-(\d+)-pericopes-([a-z]+)\.json$/);
    return m ? { chapter: parseInt(m[1]), lang: m[2] } : null;
  }

  const paths: any[] = [];
  for (const [path, mod] of Object.entries(metaModules)) {
    const p = parseMeta(path);
    if (!p) continue;
    paths.push({
      params: { lang: p.lang, chapter: String(p.chapter) },
      props: { lang: p.lang, chapter: p.chapter },
    });
  }
  return paths;
}

// ---------------------------------------------------------------------------
// Chapter subtitles (editorial teasers, English primary)
// ---------------------------------------------------------------------------
const enChapterSubtitles: Record<number, string> = {
  1:  'Two impossible pregnancies. Two revolutionary songs. The story begins.',
  2:  'Birth in a stable. Shepherds as witnesses. An old man sees salvation.',
  3:  'John preaches in the wilderness. Jesus is baptized. A genealogy back to Adam.',
  4:  'Temptation in the wilderness. Rejection at Nazareth. Authority over demons.',
  5:  'The catch of fish. Lepers and the paralyzed. Levi follows Jesus.',
  6:  'Sabbath conflicts. The Twelve are chosen. Blessings and woes.',
  7:  'The centurion\'s faith. The son of Nain. John\'s question.',
  8:  'Women who followed Jesus. Parables of the kingdom. Storm and demons.',
  9:  'The Twelve sent out. Five thousand fed. Peter\'s confession. Transfiguration.',
  10: 'The seventy-two sent out. The Good Samaritan. Mary and Martha.',
  11: 'The Lord\'s Prayer. Controversy. Woes against the religious leaders.',
  12: 'Warning against hypocrisy. Do not worry. Watch and be ready.',
  13: 'Repent or perish. A woman freed on the Sabbath. The narrow door.',
  14: 'Hosts and guests. Humility at the table. The cost of following.',
  15: 'Lost and found: sheep, coin, son.',
  16: 'The shrewd manager. The rich man and poor Lazarus.',
  17: 'Stumbling blocks. Ten men with leprosy. The coming kingdom.',
  18: 'The persistent widow. The Pharisee and the tax collector. The rich ruler.',
  19: 'Zacchaeus. The ten minas. The entry into Jerusalem.',
  20: 'The wicked tenants. Taxes. The resurrection question.',
  21: 'The widow\'s offering. Signs of the end. Watch and pray.',
  22: 'The Last Supper. Betrayal and denial. Gethsemane.',
  23: 'The trial. Crucifixion. The death of Jesus.',
  24: 'The empty tomb. The road to Emmaus. Appearances and ascension.',
};

// ---------------------------------------------------------------------------
// Page data
// ---------------------------------------------------------------------------
const { lang, chapter } = Astro.props;
const t = useTranslations(lang);
const chapterNum = typeof chapter === 'string' ? parseInt(chapter) : chapter;

// Prefer lang-specific data, fall back to English
const data =
  metaByLangChapter[lang]?.[chapterNum] ??
  metaByLangChapter['en']?.[chapterNum];

const pericopes = data?.pericopes ?? [];
const chapterPodcast = data?.chapterPodcast ?? null;

// Book name
const bookName: string = (data?.book as string) || (t as any)('nav.luke') || 'Luke';

// Chapter word (localized)
const chapWordMap: Record<string, string> = {
  ar: 'الفصل', bg: 'Глава', ca: 'Capítol', cs: 'Kapitola', da: 'Kapitel',
  de: 'Kapitel', el: 'Κεφάλαιο', es: 'Capítulo', et: 'Peatükk', fi: 'Luku',
  fr: 'Chapitre', ga: 'Caibidil', hr: 'Poglavlje', hu: 'Fejezet', it: 'Capitolo',
  lt: 'Skyrius', lv: 'Nodaļa', mt: 'Kapitlu', nb: 'Kapittel', nl: 'Hoofdstuk',
  pl: 'Rozdział', pt: 'Capítulo', ro: 'Capitol', ru: 'Глава', sk: 'Kapitola',
  sl: 'Poglavje', sq: 'Kapitulli', sv: 'Kapitel', tr: 'Bölüm', uk: 'Розділ',
};
const chapWord = chapWordMap[lang] ?? 'Chapter';

// Chapter subtitle (English editorial teasers; other languages TBD)
const subtitle = lang === 'en' ? enChapterSubtitles[chapterNum] : null;

const totalChapters = 24;
const prevChapter = chapterNum > 1 ? chapterNum - 1 : null;
const nextChapter = chapterNum < totalChapters ? chapterNum + 1 : null;

const pageTitle = `${bookName} ${chapterNum}`;
const licenseMap: Record<string, string> = {
  de: 'Übersetzung: Aperto Bibel (AB-DE) | Lizenz: CC BY-SA 4.0',
  fr: 'Traduction: Bible Aperto (AB-FR) | Licence: CC BY-SA 4.0',
  es: 'Traducción: Biblia Aperto (AB-ES) | Licencia: CC BY-SA 4.0',
  pl: 'Przekład: Aperto Biblia (AB-PL) | Licencja: CC BY-SA 4.0',
};
const licenseNote = licenseMap[lang] ?? `Translation: Aperto Bible (AB-${lang.toUpperCase()}) | License: CC BY-SA 4.0`;
---

<BaseLayout title={pageTitle} lang={lang} description={`${bookName} ${chapWord} ${chapterNum}`}>
  <BookNav currentChapter={chapterNum} lang={lang} />

  <header class="chapter-header">
    <p class="passage-reference">{(t as any)('nav.gospel') ?? `The Gospel of ${bookName}`}</p>
    <h1 class="headline-mixed">
      <span class="cap">{chapWord.charAt(0)}</span>{chapWord.slice(1)} {chapterNum}
    </h1>

    {subtitle && (
      <details class="chapter-intro">
        <summary class="chapter-intro-teaser">
          {subtitle}
          <svg class="intro-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <p class="chapter-intro-expanded">
          {subtitle}
        </p>
      </details>
    )}

    {chapterPodcast && (
      <button
        class="chapter-podcast-btn media-play-btn"
        data-mp3={`/audio/podcasts/${chapterPodcast.mp3}`}
        data-title={chapterPodcast.title}
        data-type="podcast"
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/></svg>
        <span>{chapterPodcast.title}</span>
      </button>
    )}
  </header>

  <section class="pericope-grid-section">
    <div class="pericope-grid">
      {pericopes.map((p: any) => (
        <a href={`/${lang}/luke/${chapterNum}/${p.id}`} class="pericope-thumb">
          {p.image && (
            <div class="pericope-thumb-img-wrap">
              <img
                src={`/images/luke/${chapterNum}/${p.image}`}
                alt={p.imageAlt || p.title}
                class="pericope-thumb-img"
                loading="lazy"
              />
            </div>
          )}
          <div class="pericope-thumb-info" style={`background-color: ${p.color};`}>
            <span class="pericope-thumb-verses">{p.verses}</span>
            <span class="pericope-thumb-title">{p.title}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <footer class="chapter-footer">
    <div class="chapter-footer-nav">
      {prevChapter && (
        <a href={`/${lang}/luke/${prevChapter}`} class="footer-nav-btn footer-nav-prev">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          {chapWord} {prevChapter}
        </a>
      )}
      {nextChapter && (
        <a href={`/${lang}/luke/${nextChapter}`} class="footer-nav-btn">
          {chapWord} {nextChapter}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </a>
      )}
    </div>
    <p class="license-note">{licenseNote}</p>
  </footer>
</BaseLayout>

<style>
  .chapter-header {
    padding: 3rem 2rem 2.5rem;
    text-align: center;
    background: linear-gradient(180deg, #FFFBF5 0%, #F5EBE0 100%);
    border-bottom: 1px solid rgba(139, 115, 85, 0.12);
  }
  .passage-reference {
    font-family: 'Switzer', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent, #8B7355);
    margin-bottom: 0.5rem;
  }
  .headline-mixed {
    font-size: clamp(2.5rem, 7vw, 5rem);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  /* Collapsible chapter intro */
  .chapter-intro {
    max-width: 34rem;
    margin: 0 auto 1.5rem;
    text-align: left;
  }
  .chapter-intro-teaser {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: 'Switzer', sans-serif;
    font-size: 0.95rem;
    color: var(--color-warm-gray, #9A8A7A);
    line-height: 1.6;
    cursor: pointer;
    list-style: none;
    text-align: center;
  }
  .chapter-intro-teaser::-webkit-details-marker { display: none; }
  .intro-chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
    color: var(--color-accent, #8B7355);
    opacity: 0.6;
  }
  .chapter-intro[open] .intro-chevron { transform: rotate(180deg); }
  .chapter-intro[open] .chapter-intro-teaser {
    opacity: 0.5;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .chapter-intro-expanded {
    font-family: 'Switzer', sans-serif;
    font-size: 1.05rem;
    color: var(--color-charcoal, #3D3530);
    line-height: 1.7;
    text-align: center;
    max-width: 32rem;
    margin: 0 auto;
  }

  .chapter-podcast-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.55rem 1.1rem;
    border-radius: 9999px;
    background: rgba(44, 44, 44, 0.82);
    color: #FFFBF5;
    font-family: 'Switzer', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    border: none;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: opacity 0.18s ease;
  }
  .chapter-podcast-btn:hover { opacity: 0.8; }

  .pericope-grid-section {
    padding: 2.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .pericope-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .pericope-thumb {
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--color-border, rgba(139,115,85,0.15));
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    display: flex;
    flex-direction: column;
  }
  .pericope-thumb:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
  }
  .pericope-thumb-img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
  }
  .pericope-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    display: block;
  }
  .pericope-thumb:hover .pericope-thumb-img { transform: scale(1.04); }
  .pericope-thumb-info {
    padding: 0.875rem 1.125rem 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 72px;
  }
  .pericope-thumb-verses {
    display: block;
    font-family: 'Switzer', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-warm-gray, #9A8A7A);
    margin-bottom: 0.3rem;
  }
  .pericope-thumb-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: 'Softcore', Georgia, serif;
    font-size: 1.05rem;
    font-weight: 150;
    color: var(--color-charcoal, #3D3530);
    line-height: 1.35;
  }

  .chapter-footer {
    padding: 2.5rem 2rem;
    text-align: center;
    background: #F5E6DC;
    border-top: 1px solid rgba(139, 115, 85, 0.12);
  }
  .chapter-footer-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .footer-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    background: white;
    color: #6B5A4A;
    font-family: 'Switzer', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid rgba(139, 115, 85, 0.2);
    transition: all 0.2s ease;
  }
  .footer-nav-btn:hover {
    background: #8B7355;
    color: white;
    border-color: #8B7355;
  }
  .license-note {
    font-family: 'Switzer', sans-serif;
    font-size: 0.8rem;
    color: var(--color-warm-gray, #9A8A7A);
  }
</style>
