---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
import { useTranslations } from '../../i18n/utils';
import { hasTextContent } from '../../data/textLanguages';

export function getStaticPaths() {
  return [
    { params: { lang: 'da' } },
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'sv' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ro' } },
    { params: { lang: 'cs' } },
    { params: { lang: 'el' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'bg' } },
    { params: { lang: 'hr' } },
    { params: { lang: 'fi' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'lt' } },
    { params: { lang: 'sl' } },
    { params: { lang: 'lv' } },
    { params: { lang: 'et' } },
    { params: { lang: 'ga' } },
    { params: { lang: 'mt' } },
    { params: { lang: 'nb' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'ca' } },
    { params: { lang: 'sq' } },
  ];
}

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<BaseLayout title={t('nav.process')} lang={lang}>
  <article class="py-16 md:py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl md:text-5xl mb-12 headline-mixed">{t('process.title')}</h1>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.challenge.title')}</h2>
        <p class="text-lg leading-relaxed mb-6" style="color: #5A5A5A;">
          {t('process.challenge.p1')}
        </p>
        <p class="text-lg leading-relaxed mb-6" style="color: #5A5A5A;">
          {t('process.challenge.p2')}
        </p>
        <p class="text-lg leading-relaxed" style="color: #5A5A5A;">
          {t('process.challenge.p3')}
        </p>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.philosophy.title')}</h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-xl mb-2">{t('process.philosophy.literary.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.philosophy.literary.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.philosophy.context.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.philosophy.context.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.philosophy.ecumenical.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.philosophy.ecumenical.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.philosophy.engagement.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.philosophy.engagement.desc')}</p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.theological.title')}</h2>
        <div class="space-y-8">
          <div>
            <h3 class="text-xl mb-3">{t('process.theological.pentecost.title')}</h3>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.pentecost.p1')}</p>
            <p class="text-base leading-relaxed" style="color: #5A5A5A;">{t('process.theological.pentecost.p2')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-3">{t('process.theological.reformation.title')}</h3>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.reformation.p1')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.reformation.p2')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.reformation.p3')}</p>
            <p class="text-base leading-relaxed" style="color: #5A5A5A;">{t('process.theological.reformation.p4')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-3">{t('process.theological.unexpected.title')}</h3>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.unexpected.p1')}</p>
            <ul class="list-disc pl-6 mb-3 space-y-1" style="color: #5A5A5A;">
              <li>{t('process.theological.unexpected.donkey')}</li>
              <li>{t('process.theological.unexpected.pagan')}</li>
              <li>{t('process.theological.unexpected.astrologers')}</li>
              <li>{t('process.theological.unexpected.foolish')}</li>
            </ul>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.unexpected.p2')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.unexpected.p3')}</p>
            <blockquote class="border-l-4 pl-6 py-2 my-4 italic" style="border-color: #8B7355; color: #6A6A6A;">
              {t('process.theological.unexpected.blockquote')}
            </blockquote>
          </div>
          <div>
            <h3 class="text-xl mb-3">{t('process.theological.silence.title')}</h3>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.silence.p1')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.silence.p2')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.silence.p3')}</p>
            <p class="text-base leading-relaxed" style="color: #5A5A5A;">{t('process.theological.silence.p4')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-3">{t('process.theological.possible.title')}</h3>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.possible.p1')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.possible.p2')}</p>
            <p class="text-base leading-relaxed mb-3" style="color: #5A5A5A;">{t('process.theological.possible.p3')}</p>
            <p class="text-base leading-relaxed" style="color: #5A5A5A;">{t('process.theological.possible.p4')}</p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.workflow.title')}</h2>
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">1</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step1.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step1.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">2</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step2.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step2.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">3</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step3.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step3.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">4</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step4.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step4.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">5</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step5.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step5.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">6</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step6.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step6.desc')}</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center font-medium" style="background-color: #8B7355; color: #FFFBF5;">7</div>
            <div>
              <h3 class="text-xl mb-2">{t('process.workflow.step7.title')}</h3>
              <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.workflow.step7.desc')}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <p class="text-base leading-relaxed" style="color: #5A5A5A;">
          {t('process.methodologyLink.text')} <a href={`${base}${lang}/methodology`} style="color: #8B7355; text-decoration: underline;">{t('process.methodologyLink.link')}</a>.
        </p>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.principles.title')}</h2>
        <div class="space-y-6">
          <div>
            <h3 class="text-xl mb-2">{t('process.principles.honesty.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.principles.honesty.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.principles.accessibility.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.principles.accessibility.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.principles.craft.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.principles.craft.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.principles.expectancy.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.principles.expectancy.desc')}</p>
          </div>
          <div>
            <h3 class="text-xl mb-2">{t('process.principles.humility.title')}</h3>
            <p class="leading-relaxed" style="color: #5A5A5A;">{t('process.principles.humility.desc')}</p>
          </div>
        </div>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.involved.title')}</h2>
        <p class="text-lg leading-relaxed mb-6" style="color: #5A5A5A;">
          {t('process.involved.intro')}
        </p>
        <ul class="space-y-3 mb-6" style="color: #5A5A5A;">
          <li>{t('process.involved.translation')} — <a href="https://translate.aperto.bible" class="hover:underline font-medium" style="color: #8B7355;">translate.aperto.bible</a></li>
          <li>{t('process.involved.cultural')}</li>
          <li>{t('process.involved.audio')}</li>
          <li>{t('process.involved.technical')}</li>
          <li>{t('process.involved.feedback')}</li>
        </ul>
        <p class="text-base" style="color: #5A5A5A;">
          {t('process.involved.contact')}: <ObfuscatedEmail user="tobias" domain="aperto.bible" />
        </p>
      </section>

      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{t('process.newsletter.title')}</h2>
        <p class="text-lg leading-relaxed mb-4" style="color: #5A5A5A;">
          {t('process.newsletter.intro')}
        </p>
        <p class="text-base leading-relaxed mb-8" style="color: #8B7355;">
          {t('process.newsletter.note')}
        </p>
        <form method="post" action="https://sendfox.com/form/mnwydv/1yr89o" class="sendfox-form" id="1yr89o" data-async="true" data-recaptcha="true">
          <div class="space-y-4">
            <div>
              <label for="sendfox_form_name" class="block text-sm font-medium mb-2" style="color: #5A5A5A;">{t('process.newsletter.firstName')}</label>
              <input type="text" id="sendfox_form_name" placeholder={t('process.newsletter.firstName')} name="first_name" required class="w-full px-4 py-3 rounded border focus:outline-none focus:ring-2" style="border-color: #D1D5DB; focus:ring-color: #8B7355;" />
            </div>
            <div>
              <label for="sendfox_form_email" class="block text-sm font-medium mb-2" style="color: #5A5A5A;">{t('process.newsletter.email')}</label>
              <input type="email" id="sendfox_form_email" placeholder={t('process.newsletter.email')} name="email" required class="w-full px-4 py-3 rounded border focus:outline-none focus:ring-2" style="border-color: #D1D5DB; focus:ring-color: #8B7355;" />
            </div>
            <div class="flex items-start gap-2">
              <input type="checkbox" name="gdpr" value="1" required id="gdpr" class="mt-1" />
              <label for="gdpr" class="text-sm" style="color: #5A5A5A;">{t('process.newsletter.agree')}</label>
            </div>
            <div style="position: absolute; left: -5000px;" aria-hidden="true">
              <input type="text" name="a_password" tabindex="-1" value="" autocomplete="off" />
            </div>
            <button type="submit" class="px-8 py-4 rounded font-medium transition-all hover:opacity-90" style="background-color: #8B7355; color: #FFFBF5;">
              {t('process.newsletter.button')}
            </button>
          </div>
        </form>
        <script src="https://cdn.sendfox.com/js/form.js" charset="utf-8"></script>
      </section>

      <section>
        <h2 class="text-2xl md:text-3xl mb-6 headline-mixed">{hasTextContent(lang) ? t('process.readLuke') : t('home.media.title')}</h2>
        <a href={hasTextContent(lang) ? `${base}${lang}/luke/1` : `${base}${lang}/#listen`} class="inline-block px-8 py-4 rounded font-medium transition-all hover:opacity-90" style="background-color: #8B7355; color: #FFFBF5;">
          {hasTextContent(lang) ? t('process.readLuke') : t('home.media.heroCta')}
        </a>
      </section>
    </div>
  </article>
</BaseLayout>
