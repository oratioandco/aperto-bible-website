---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'da' } },
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'sv' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ro' } },
    { params: { lang: 'cs' } },
    { params: { lang: 'el' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'bg' } },
    { params: { lang: 'hr' } },
    { params: { lang: 'fi' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'lt' } },
    { params: { lang: 'sl' } },
    { params: { lang: 'lv' } },
    { params: { lang: 'et' } },
    { params: { lang: 'ga' } },
    { params: { lang: 'mt' } },
    { params: { lang: 'nb' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'ca' } },
    { params: { lang: 'sq' } },
  ];
}

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

// Language-specific book names for Luke
const lukeNames: Record<string, string> = {
  da: 'Lukas',
  de: 'Lukas',
  en: 'Luke',
  es: 'Lucas',
  fr: 'Luc',
  it: 'Luca',
  pl: 'Łukasz',
  pt: 'Lucas',
  sv: 'Lukas',
  tr: 'Luka',
  uk: 'Луки',
  nl: 'Lucas',
  ro: 'Luca',
  cs: 'Lukáš',
  el: 'Λουκάς',
  hu: 'Lukács',
  bg: 'Лука',
  hr: 'Luka',
  fi: 'Luukas',
  sk: 'Lukáš',
  lt: 'Luko',
  sl: 'Luka',
  lv: 'Lūka',
  et: 'Luuka',
  ga: 'Lúcás',
  mt: 'Luqa',
  nb: 'Lukas',
  ru: 'Луки',
  ar: 'لوقا',
  ca: 'Lluc',
  sq: 'Luka',
};
---

<BaseLayout title={t('nav.home')} lang={lang}>
  <!-- Alpha Notice Banner -->
  <div class="px-4 py-3 text-center" style="background-color: #F5E6DC;">
    <p class="text-sm" style="color: #5A5A5A;">
      <span class="font-medium" style="color: #8B7355;">{t('home.alphaNotice')}</span> — {t('home.alphaText')}
    </p>
  </div>

  <!-- Hero Image -->
  <div class="w-full overflow-hidden" style="max-height: 52vh;">
    <img
      src={`${base}images/homepage_hero.png`}
      alt=""
      aria-hidden="true"
      class="w-full object-cover"
      style="object-position: center 40%;"
    />
  </div>

  <section class="hero min-h-[80vh] flex items-center justify-center px-8 md:px-16 lg:px-24">
    <div class="blob blob-1" aria-hidden="true"></div>
    <div class="blob blob-2" aria-hidden="true"></div>
    <div class="blob blob-3" aria-hidden="true"></div>
    <div class="hero-content max-w-4xl mx-auto text-center">
      <h1 class="hero-wordmark mb-8 tracking-tight logo" style="color: var(--color-headline);">aperto</h1>
      <p class="text-xl md:text-2xl leading-relaxed max-w-2xl mx-auto mb-12" style="color: #5A5A5A;">
        {t('home.tagline')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
        <a href={`${base}${lang}/luke/1`} class="px-8 py-4 rounded font-medium transition-all hover:opacity-90" style="background-color: #8B7355; color: #FFFBF5;">
          {t('home.readLuke')} ({lukeNames[lang]})
        </a>
      </div>
    </div>
  </section>

  <!-- Image marquee strip -->
  <div class="image-marquee" aria-hidden="true">
    <div class="marquee-track">
      {[
        '/images/luke/1/luke_01_annunciation.png',
        '/images/luke/1/luke_01_magnificat.png',
        '/images/luke/2/luke_02_nativity.png',
        '/images/luke/2/luke_02_shepherds.png',
        '/images/luke/3/luke_03_jesus_baptism.png',
        '/images/luke/4/luke_04_rejection-nazareth.png',
        '/images/luke/7/luke_07_sinful-woman.png',
        '/images/luke/9/luke_09_transfiguration.png',
        '/images/luke/10/luke_10_good-samaritan.png',
        '/images/luke/24/luke_24_empty_tomb.png',
        '/images/luke/1/luke_01_visitation.png',
        '/images/luke/2/luke_02_simeon.png',
      ].concat([
        '/images/luke/1/luke_01_annunciation.png',
        '/images/luke/1/luke_01_magnificat.png',
        '/images/luke/2/luke_02_nativity.png',
        '/images/luke/2/luke_02_shepherds.png',
        '/images/luke/3/luke_03_jesus_baptism.png',
        '/images/luke/4/luke_04_rejection-nazareth.png',
        '/images/luke/7/luke_07_sinful-woman.png',
        '/images/luke/9/luke_09_transfiguration.png',
        '/images/luke/10/luke_10_good-samaritan.png',
        '/images/luke/24/luke_24_empty_tomb.png',
        '/images/luke/1/luke_01_visitation.png',
        '/images/luke/2/luke_02_simeon.png',
      ]).map((src) => (
        <img src={src} alt="" class="marquee-img" loading="lazy" />
      ))}
    </div>
  </div>

  <style>
    /* Hero blob animation */
    .hero {
      position: relative;
      overflow: hidden;
    }

    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      will-change: transform;
      pointer-events: none;
    }

    .blob-1 {
      width: 700px;
      height: 700px;
      background: radial-gradient(ellipse, rgba(210, 100, 70, 0.32) 0%, transparent 70%);
      top: -180px;
      left: -160px;
      animation: drift1 22s ease-in-out infinite alternate;
    }

    .blob-2 {
      width: 550px;
      height: 550px;
      background: radial-gradient(ellipse, rgba(180, 110, 150, 0.28) 0%, transparent 70%);
      bottom: -120px;
      right: -100px;
      animation: drift2 29s ease-in-out infinite alternate;
    }

    .blob-3 {
      width: 500px;
      height: 500px;
      background: radial-gradient(ellipse, rgba(240, 170, 80, 0.32) 0%, transparent 70%);
      top: 30%;
      left: 55%;
      animation: drift3 37s ease-in-out infinite alternate;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-wordmark {
      font-size: clamp(5rem, 14vw, 13rem);
      line-height: 1;
    }

    @keyframes drift1 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(90px, 70px) scale(1.12); }
    }

    @keyframes drift2 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-70px, -90px) scale(1.08); }
    }

    @keyframes drift3 {
      0%   { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-50px, 60px) scale(0.92); }
    }

    /* Image marquee */
    .image-marquee {
      overflow: hidden;
      width: 100%;
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .marquee-track {
      display: flex;
      gap: 12px;
      width: max-content;
      animation: marquee 60s linear infinite;
    }

    .marquee-img {
      height: 260px;
      width: auto;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
      filter: saturate(0.85);
    }

    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .blob { animation: none; }
      .marquee-track { animation: none; }
    }

    /* Get Involved section */
    .get-involved-section {
      background-color: var(--color-charcoal);
      color: var(--color-cream);
    }

    .get-involved-section h2 {
      color: var(--color-cream);
    }

    .get-involved-section p {
      color: rgba(255, 251, 245, 0.7);
    }

    .get-involved-btn {
      background-color: var(--color-cream);
      color: var(--color-charcoal);
    }

    @media (prefers-color-scheme: dark) {
      .get-involved-section {
        background-color: #111111;
        color: #f0ebe3;
      }

      .get-involved-section h2 {
        color: #f0ebe3;
      }

      .get-involved-section p {
        color: rgba(240, 235, 227, 0.65);
      }

      .get-involved-btn {
        background-color: #f0ebe3;
        color: #111111;
      }
    }
  </style>

  <section class="py-24 px-8 md:px-16 lg:px-24" style="background-color: rgba(245, 230, 220, 0.3);">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl mb-12 text-center headline-mixed">{t('home.differentBible')}</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.accessible')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.accessibleDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.multimedia')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.multimediaDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.openSource')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.openSourceDesc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-8 headline-mixed">{t('home.startReading')}</h2>
      <p class="text-lg leading-relaxed mb-12" style="color: #6A6A6A;">
        {t('home.startReadingDesc')}
      </p>
      <a
        href={`${base}${lang}/luke/1`}
        class="inline-block px-8 py-4 rounded font-medium transition-all hover:opacity-90"
        style="background-color: #8B7355; color: #FFFBF5;"
      >
        {lukeNames[lang]} 1
      </a>
    </div>
  </section>

  <!-- Get Involved -->
  <section class="get-involved-section py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-6">{t('home.getInvolved.title')}</h2>
      <p class="text-lg leading-relaxed mb-10">
        {t('home.getInvolved.description')}
      </p>
      <button
        class="get-involved-btn px-8 py-4 rounded font-medium transition-all hover:opacity-90 cursor-pointer"
      >
        {t('home.getInvolved.button')}
      </button>
    </div>
  </section>

  <script is:inline>
    document.querySelector('.get-involved-btn')?.addEventListener('click', function() {
      if (typeof Tally !== 'undefined') {
        Tally.openPopup('b58vj1', { width: 600 });
      } else {
        window.open('https://tally.so/r/b58vj1', '_blank');
      }
    });
  </script>
</BaseLayout>
