---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'da' } },
    { params: { lang: 'de' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'pl' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'sv' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'nl' } },
    { params: { lang: 'ro' } },
    { params: { lang: 'cs' } },
    { params: { lang: 'el' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'bg' } },
    { params: { lang: 'hr' } },
    { params: { lang: 'fi' } },
    { params: { lang: 'sk' } },
    { params: { lang: 'lt' } },
    { params: { lang: 'sl' } },
    { params: { lang: 'lv' } },
    { params: { lang: 'et' } },
    { params: { lang: 'ga' } },
    { params: { lang: 'mt' } },
    { params: { lang: 'nb' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'ar' } },
    { params: { lang: 'ca' } },
    { params: { lang: 'sq' } },
  ];
}

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

// Language-specific book names for Luke
const lukeNames: Record<string, string> = {
  da: 'Lukas',
  de: 'Lukas',
  en: 'Luke',
  es: 'Lucas',
  fr: 'Luc',
  it: 'Luca',
  pl: 'Łukasz',
  pt: 'Lucas',
  sv: 'Lukas',
  tr: 'Luka',
  uk: 'Луки',
  nl: 'Lucas',
  ro: 'Luca',
  cs: 'Lukáš',
  el: 'Λουκάς',
  hu: 'Lukács',
  bg: 'Лука',
  hr: 'Luka',
  fi: 'Luukas',
  sk: 'Lukáš',
  lt: 'Luko',
  sl: 'Luka',
  lv: 'Lūka',
  et: 'Luuka',
  ga: 'Lúcás',
  mt: 'Luqa',
  nb: 'Lukas',
  ru: 'Луки',
  ar: 'لوقا',
  ca: 'Lluc',
  sq: 'Luka',
};
---

<BaseLayout title={t('nav.home')} lang={lang} heroPage={true}>
  <!-- Video Hero -->
  <section class="video-hero">
    <!-- Background video -->
    <video
      class="video-bg"
      src={`${base}videos/hero.mp4`}
      poster={`${base}images/homepage_hero_blue_hour_low.png`}
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <!-- Color overlay -->
    <div class="video-overlay" aria-hidden="true"></div>
    <!-- Grain overlay -->
    <div class="video-grain" aria-hidden="true" style={`background-image: url(${base}images/grain.gif)`}></div>
    <!-- Content -->
    <div class="video-hero-content">
      <h1 class="hero-wordmark tracking-tight logo">aperto</h1>
      <p class="hero-tagline">
        {t('home.tagline')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center flex-wrap">
        <a href={`${base}${lang}/luke/1`} class="hero-btn">
          {t('home.readLuke')} ({lukeNames[lang]})
        </a>
      </div>
    </div>
  </section>

  <!-- Image marquee strip -->
  <div class="image-marquee" aria-hidden="true">
    <div class="marquee-track">
      {[
        '/images/luke/1/luke_01_annunciation.png',
        '/images/luke/1/luke_01_magnificat.png',
        '/images/luke/2/luke_02_nativity.png',
        '/images/luke/2/luke_02_shepherds.png',
        '/images/luke/3/luke_03_jesus_baptism.png',
        '/images/luke/4/luke_04_rejection-nazareth.png',
        '/images/luke/7/luke_07_sinful-woman.png',
        '/images/luke/9/luke_09_transfiguration.png',
        '/images/luke/10/luke_10_good-samaritan.png',
        '/images/luke/24/luke_24_empty_tomb.png',
        '/images/luke/1/luke_01_visitation.png',
        '/images/luke/2/luke_02_simeon.png',
      ].concat([
        '/images/luke/1/luke_01_annunciation.png',
        '/images/luke/1/luke_01_magnificat.png',
        '/images/luke/2/luke_02_nativity.png',
        '/images/luke/2/luke_02_shepherds.png',
        '/images/luke/3/luke_03_jesus_baptism.png',
        '/images/luke/4/luke_04_rejection-nazareth.png',
        '/images/luke/7/luke_07_sinful-woman.png',
        '/images/luke/9/luke_09_transfiguration.png',
        '/images/luke/10/luke_10_good-samaritan.png',
        '/images/luke/24/luke_24_empty_tomb.png',
        '/images/luke/1/luke_01_visitation.png',
        '/images/luke/2/luke_02_simeon.png',
      ]).map((src) => (
        <img src={src} alt="" class="marquee-img" loading="lazy" />
      ))}
    </div>
  </div>

  <style>
    /* Video Hero */
    .video-hero {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    /* Bottom fade-out to page background */
    .video-hero::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 220px;
      background: linear-gradient(to bottom, transparent 0%, #FFFBF5 100%);
      z-index: 4;
      pointer-events: none;
    }

    .video-bg {
      position: absolute;
      inset: -30px;
      width: calc(100% + 60px);
      height: calc(100% + 60px);
      object-fit: cover;
      object-position: center center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
    }

    .video-overlay {
      position: absolute;
      inset: 0;
      background: rgba(18, 10, 5, 0.38);
      z-index: 1;
    }

    .video-grain {
      position: absolute;
      inset: 0;
      opacity: 0.09;
      background-repeat: repeat;
      background-size: 128px auto;
      z-index: 2;
    }

    .video-hero-content {
      position: relative;
      z-index: 3;
      text-align: center;
      padding: 2rem;
      max-width: 56rem;
      margin: 0 auto;
    }

    .hero-wordmark {
      font-size: clamp(5rem, 16vw, 14rem);
      line-height: 1;
      color: #FFFBF5;
      margin-bottom: 1.5rem;
      text-shadow: 0 2px 32px rgba(0,0,0,0.25);
    }

    .hero-tagline {
      font-size: clamp(1rem, 2.2vw, 1.4rem);
      line-height: 1.6;
      color: rgba(255, 251, 245, 0.82);
      max-width: 36rem;
      margin: 0 auto 2.5rem;
    }

    .hero-btn {
      display: inline-block;
      padding: 0.9rem 2.2rem;
      border-radius: 6px;
      font-weight: 500;
      background-color: rgba(255, 251, 245, 0.15);
      color: #FFFBF5;
      border: 1px solid rgba(255, 251, 245, 0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: background-color 0.2s, border-color 0.2s;
      text-decoration: none;
    }

    .hero-btn:hover {
      background-color: rgba(255, 251, 245, 0.26);
      border-color: rgba(255, 251, 245, 0.55);
    }

    .video-hero::before {
      content: '';
      position: absolute;
      inset: -30px;
      width: calc(100% + 60px);
      height: calc(100% + 60px);
      background-image: url('/images/homepage_hero_blue_hour_low.png');
      background-size: cover;
      background-position: center;
      filter: blur(30px);
      -webkit-filter: blur(30px);
      z-index: 0;
      opacity: 0;
      transition: opacity 0.3s;
    }

    @media (prefers-reduced-motion: reduce) {
      .video-bg { display: none; }
      .video-hero::before { opacity: 1; }
    }

    /* Image marquee */
    .image-marquee {
      overflow: hidden;
      width: 100%;
      mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .marquee-track {
      display: flex;
      gap: 12px;
      width: max-content;
      animation: marquee 60s linear infinite;
    }

    .marquee-img {
      height: 260px;
      width: auto;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
      filter: saturate(0.85);
    }

    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none; }
    }

    /* Get Involved section */
    .get-involved-section {
      background-color: var(--color-charcoal);
      color: var(--color-cream);
    }

    .get-involved-section h2 {
      color: var(--color-cream);
    }

    .get-involved-section p {
      color: rgba(255, 251, 245, 0.7);
    }

    .get-involved-btn {
      background-color: var(--color-cream);
      color: var(--color-charcoal);
    }

    @media (prefers-color-scheme: dark) {
      .get-involved-section {
        background-color: #111111;
        color: #f0ebe3;
      }

      .get-involved-section h2 {
        color: #f0ebe3;
      }

      .get-involved-section p {
        color: rgba(240, 235, 227, 0.65);
      }

      .get-involved-btn {
        background-color: #f0ebe3;
        color: #111111;
      }
    }
  </style>

  <section class="py-24 px-8 md:px-16 lg:px-24" style="background-color: rgba(245, 230, 220, 0.3);">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl mb-12 text-center headline-mixed">{t('home.differentBible')}</h2>
      <div class="grid md:grid-cols-3 gap-12">
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.accessible')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.accessibleDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.multimedia')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.multimediaDesc')}
          </p>
        </div>
        <div class="text-center">
          <h3 class="text-xl mb-3">{t('home.openSource')}</h3>
          <p class="leading-relaxed" style="color: #6A6A6A;">
            {t('home.openSourceDesc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-8 headline-mixed">{t('home.startReading')}</h2>
      <p class="text-lg leading-relaxed mb-12" style="color: #6A6A6A;">
        {t('home.startReadingDesc')}
      </p>
      <a
        href={`${base}${lang}/luke/1`}
        class="inline-block px-8 py-4 rounded font-medium transition-all hover:opacity-90"
        style="background-color: #8B7355; color: #FFFBF5;"
      >
        {lukeNames[lang]} 1
      </a>
    </div>
  </section>

  <!-- Get Involved -->
  <section class="get-involved-section py-24 px-8 md:px-16 lg:px-24">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl mb-6">{t('home.getInvolved.title')}</h2>
      <p class="text-lg leading-relaxed mb-10">
        {t('home.getInvolved.description')}
      </p>
      <button
        class="get-involved-btn px-8 py-4 rounded font-medium transition-all hover:opacity-90 cursor-pointer"
      >
        {t('home.getInvolved.button')}
      </button>
    </div>
  </section>

  <script is:inline>
    document.querySelector('.get-involved-btn')?.addEventListener('click', function() {
      if (typeof Tally !== 'undefined') {
        Tally.openPopup('b58vj1', { width: 600 });
      } else {
        window.open('https://tally.so/r/b58vj1', '_blank');
      }
    });
  </script>
</BaseLayout>
