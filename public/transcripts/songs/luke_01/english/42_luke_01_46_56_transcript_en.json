          "start_ms": 49543,
          "end_ms": 53171
        },
        {
          "text": "They never saw me coming",
          "start_ms": 53171,
          "end_ms": 56800
        },
        {
          "text": "I am the nobody, the nobody",
          "start_ms": 56800,
          "end_ms": 60428
        },
        {
          "text": "Now watch me while I am running",
          "start_ms": 60428,
          "end_ms": 64057
        },
        {
          "text": "Everything in me celebrates",
          "start_ms": 64057,
          "end_ms": 67686
        },
        {
          "text": "I can not hold it in, I will not hold it back",
          "start_ms": 67686,
          "end_ms": 71314
        },
        {
          "text": "I am the nobody, the nobody",
          "start_ms": 71314,
          "end_ms": 74943
        },
        {
          "text": "And I am never going back",
          "start_ms": 74943,
          "end_ms": 78572
