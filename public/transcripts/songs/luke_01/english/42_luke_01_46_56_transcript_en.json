      ],
      "start_ms": 49543,
      "end_ms": 78572
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "text": "The proud ones walking tall, so sure",
          "start_ms": 79072,
          "end_ms": 82700
        },
        {
          "text": "But they do not know what is coming for them",
          "start_ms": 82700,
          "end_ms": 86329
        },
        {
          "text": "Scattered like leaves when the wind hits hard",
          "start_ms": 86329,
          "end_ms": 89957
        },
        {
          "text": "The ones who thought they held the cards",
          "start_ms": 89957,
          "end_ms": 93586
        },
        {
          "text": "The thrones they built are coming down",
          "start_ms": 93586,
          "end_ms": 97215
        },
        {
          "text": "The small ones rising off the ground",
          "start_ms": 97215,
          "end_ms": 100843
        },
        {
          "text": "The hungry finally getting fed",
          "start_ms": 100843,
          "end_ms": 104472
        },
        {
          "text": "The rich left empty-handed instead",
          "start_ms": 104472,
          "end_ms": 108101
