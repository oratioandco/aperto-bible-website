          "start_ms": 34529,
          "end_ms": 38157
        },
        {
          "text": "Is ready to explode",
          "start_ms": 38157,
          "end_ms": 41786
        },
        {
          "text": "Everything in me, everything",
          "start_ms": 41786,
          "end_ms": 45414
        },
