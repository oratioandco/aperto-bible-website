      "label": "Verse 1",
      "lines": [
        {
          "text": "Nine months of silence",
          "start_ms": 5000,
          "end_ms": 8991
        },
        {
          "text": "I forgot the sound of my own voice",
          "start_ms": 8991,
          "end_ms": 12983
        },
        {
          "text": "Every word I wanted to say",
          "start_ms": 12983,
          "end_ms": 16974
        },
        {
          "text": "Locked behind a door with no choice",
          "start_ms": 16974,
          "end_ms": 20966
        },
        {
          "text": "Now my mouth is open",
          "start_ms": 20966,
          "end_ms": 24957
        },
        {
          "text": "And these are my first words to you",
          "start_ms": 24957,
          "end_ms": 28949
        },
        {
          "text": "After all this waiting",
          "start_ms": 28949,
          "end_ms": 32940
        },
        {
          "text": "Let me tell you what is true",
          "start_ms": 32940,
          "end_ms": 36932
        }
      ],
      "start_ms": 5000,
      "end_ms": 36932
    },
    {
      "type": "chorus",
      "label": "Pre-Chorus",
      "lines": [
