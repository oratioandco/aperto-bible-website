      "label": "Verse 2",
      "lines": [
        {
          "text": "And you, my child",
          "start_ms": 58920,
          "end_ms": 60920
        },
        {
          "text": "I am speaking this over you tonight",
          "start_ms": 60920,
          "end_ms": 63720
        },
        {
          "text": "Before you understand these words",
