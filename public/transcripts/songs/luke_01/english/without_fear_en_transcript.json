          "start_ms": 27640,
          "end_ms": 30680
        },
        {
          "text": "Light on the edge of morning",
          "start_ms": 30680,
          "end_ms": 32920
        },
        {
          "text": "I can feel it in my heart",
          "start_ms": 32920,
          "end_ms": 34920
        },
        {
          "text": "A new day is dawning",
          "start_ms": 34920,
          "end_ms": 36920
