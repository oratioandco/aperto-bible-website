      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "text": "Nine months of silence",
          "start_ms": 6000,
          "end_ms": 8000
        },
        {
          "text": "I forgot the sound of my own voice",
          "start_ms": 8000,
          "end_ms": 10720
        },
        {
          "text": "Every word I wanted to say",
          "start_ms": 10720,
          "end_ms": 12800
        },
        {
          "text": "Locked behind a door with no choice",
          "start_ms": 12800,
          "end_ms": 15600
        },
        {
          "text": "Now my mouth is open",
          "start_ms": 15600,
          "end_ms": 17600
        },
        {
          "text": "And these are my first words to you",
          "start_ms": 17600,
          "end_ms": 20400
        },
        {
          "text": "After all this waiting",
          "start_ms": 20400,
          "end_ms": 22400
        },
        {
          "text": "Let me tell you what is true",
          "start_ms": 22400,
          "end_ms": 24640
        }
      ],
      "start_ms": 6000,
      "end_ms": 24640
    },
    {
      "type": "pre-chorus",
      "label": "Pre-Chorus",
      "lines": [
