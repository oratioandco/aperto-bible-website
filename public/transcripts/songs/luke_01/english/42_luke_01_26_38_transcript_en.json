    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "text": "I can see what this will cost me",
          "start_ms": 87128,
          "end_ms": 91371
        },
        {
          "text": "Everything I thought was mine",
          "start_ms": 91371,
          "end_ms": 95615
        },
        {
          "text": "The future that I planned so carefully",
          "start_ms": 95615,
          "end_ms": 99858
        },
        {
          "text": "Is dissolving line by line",
          "start_ms": 99858,
          "end_ms": 104102
        },
        {
          "text": "But before I give you my answer",
          "start_ms": 104102,
          "end_ms": 108346
        },
        {
          "text": "I need to know just one thing",
          "start_ms": 108346,
          "end_ms": 112589
        },
        {
          "text": "Am I someone you'll remember",
          "start_ms": 112589,
          "end_ms": 116833
