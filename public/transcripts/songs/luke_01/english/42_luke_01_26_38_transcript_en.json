      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "text": "The words hit me like a wave",
          "start_ms": 5000,
          "end_ms": 9243
        },
        {
          "text": "I could barely catch my breath",
          "start_ms": 9243,
          "end_ms": 13487
        },
        {
          "text": "Everything I thought I knew",
          "start_ms": 13487,
          "end_ms": 17730
        },
        {
          "text": "Scattered on the floor",
          "start_ms": 17730,
          "end_ms": 21974
        },
        {
          "text": "Just a girl in an empty room",
          "start_ms": 21974,
          "end_ms": 26218
        },
        {
          "text": "Nothing special, nothing more",
          "start_ms": 26218,
          "end_ms": 30461
        },
        {
          "text": "Then you spoke and the world cracked open",
          "start_ms": 30461,
          "end_ms": 34705
        },
        {
          "text": "Like it never had before",
          "start_ms": 34705,
          "end_ms": 38949
        }
      ],
      "start_ms": 5000,
      "end_ms": 38949
    },
    {
      "type": "chorus",
      "label": "Pre-Chorus",
      "lines": [
        {
          "text": "How is this even possible",
          "start_ms": 39449,
          "end_ms": 43692
        },
        {
          "text": "I don't know what to say",
          "start_ms": 43692,
          "end_ms": 47936
        },
        {
          "text": "But something in me recognizes you",
          "start_ms": 47936,
          "end_ms": 52179
        },
        {
          "text": "Like I've known you all my days",
          "start_ms": 52179,
          "end_ms": 56423
        }
      ],
      "start_ms": 39449,
      "end_ms": 56423
    },
    {
