    {
      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "text": "I can feel it rising up inside",
          "start_ms": 6000,
          "end_ms": 8400
        },
        {
          "text": "This fire burning, I can not keep it quiet",
          "start_ms": 8400,
          "end_ms": 11760
        },
        {
          "text": "You found me in the corner, overlooked",
          "start_ms": 11760,
          "end_ms": 14800
        },
        {
          "text": "The one they never gave a second look",
          "start_ms": 14800,
          "end_ms": 17760
        },
        {
          "text": "Small town, small name, small dreams they said",
          "start_ms": 17760,
          "end_ms": 21440
        },
        {
          "text": "But something woke up in my chest instead",
          "start_ms": 21440,
          "end_ms": 24720
        },
        {
          "text": "Everything in me is coming alive",
          "start_ms": 24720,
          "end_ms": 27280
        },
        {
          "text": "I was made for more than just survive",
          "start_ms": 27280,
          "end_ms": 30240
        }
      ],
      "start_ms": 6000,
      "end_ms": 30240
    },
    {
      "type": "pre-chorus",
      "label": "Pre-Chorus",
      "lines": [
        {
