          "start_ms": 33240,
          "end_ms": 35480
        },
        {
          "text": "Is ready to explode",
          "start_ms": 35480,
          "end_ms": 37480
        },
        {
          "text": "Everything in me, everything",
          "start_ms": 37480,
          "end_ms": 39720
