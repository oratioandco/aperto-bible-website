      "label": "Verse 1",
      "lines": [
        {
          "text": "Nove meses em silêncio",
          "start_ms": 5000,
          "end_ms": 8852
        },
        {
          "text": "Sem poder dizer nada",
          "start_ms": 8852,
          "end_ms": 12705
        },
        {
          "text": "Nove meses a esperar",
          "start_ms": 12705,
          "end_ms": 16558
        },
        {
          "text": "Que a promessa se cumprisse",
          "start_ms": 16558,
          "end_ms": 20411
        },
        {
          "text": "E agora que posso falar",
          "start_ms": 20411,
          "end_ms": 24263
        },
        {
          "text": "O que é que vou dizer primeiro",
          "start_ms": 24263,
          "end_ms": 28116
        },
        {
          "text": "Depois de tanto tempo calado",
          "start_ms": 28116,
          "end_ms": 31969
        },
        {
          "text": "Que palavras vou escolher",
          "start_ms": 31969,
          "end_ms": 35822
        }
      ],
      "start_ms": 5000,
      "end_ms": 35822
    },
    {
