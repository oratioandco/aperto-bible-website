      "label": "Verse 1",
      "lines": [
        {
          "text": "Kleines Zimmer, nichts Besondres",
          "start_ms": 5000,
          "end_ms": 8550
        },
        {
          "text": "Kleines Leben, kleines Dorf",
          "start_ms": 8550,
          "end_ms": 12100
        },
        {
          "text": "Und dann plötzlich diese Worte",
          "start_ms": 12100,
          "end_ms": 15650
        },
        {
          "text": "Die mich treffen wie ein Sturm",
          "start_ms": 15650,
          "end_ms": 19201
        },
        {
          "text": "Alles bebt, ich kann nicht atmen",
          "start_ms": 19201,
          "end_ms": 22751
        },
        {
          "text": "Was passiert hier, wer bist du",
          "start_ms": 22751,
          "end_ms": 26301
        },
        {
          "text": "Meine Hände zittern, mein Herz rast",
          "start_ms": 26301,
          "end_ms": 29851
        },
        {
          "text": "Und ich weiß nicht mehr wozu",
          "start_ms": 29851,
          "end_ms": 33402
        }
      ],
      "start_ms": 5000,
      "end_ms": 33402
    },
    {
      "type": "chorus",
      "label": "Pre-Chorus",
      "lines": [
