          "start_ms": 33902,
          "end_ms": 37452
        },
        {
          "text": "Was ich niemals glauben kann",
          "start_ms": 37452,
          "end_ms": 41002
        },
        {
          "text": "Doch sie sagt auch etwas anderes",
          "start_ms": 41002,
          "end_ms": 44552
        },
        {
          "text": "Etwas, das mich hält",
          "start_ms": 44552,
          "end_ms": 48103
