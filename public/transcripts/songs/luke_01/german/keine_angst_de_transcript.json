  "sections": [
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "text": "Keine Angst, keine Angst",
          "start_ms": 6000,
          "end_ms": 8000
        },
        {
          "text": "Ich weiß, du zitterst, ich weiß, du brichst fast",
          "start_ms": 8000,
          "end_ms": 11840
        },
        {
          "text": "Keine Angst, keine Angst",
          "start_ms": 11840,
          "end_ms": 13840
        },
        {
          "text": "Gott hat dich gehört, das ist kein Traum",
          "start_ms": 13840,
          "end_ms": 17040
        },
        {
          "text": "Das Unmögliche klopft an",
          "start_ms": 17040,
          "end_ms": 19040
        },
        {
          "text": "Bei dir, bei mir, bei uns",
          "start_ms": 19040,
          "end_ms": 21040
        },
        {
          "text": "Keine Angst – das ist sein erstes Wort",
          "start_ms": 21040,
          "end_ms": 24080
        },
        {
          "text": "Bevor er sagt, was kommt",
          "start_ms": 24080,
          "end_ms": 26080
        }
      ],
      "start_ms": 6000,
      "end_ms": 26080
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "text": "Sechs Monate später, kleines Dorf, junge Frau",
          "start_ms": 29080,
          "end_ms": 32680
        },
        {
          "text": "Maria, jung, verlobt, ihr Leben vorgezeichnet",
          "start_ms": 32680,
          "end_ms": 36280
        },
        {
          "text": "Und dann steht da einer, der alles umwirft",
          "start_ms": 36280,
          "end_ms": 39640
        },
        {
          "text": "Worte, die ihr Leben in Stücke reißen könnten",
          "start_ms": 39640,
          "end_ms": 43240
        },
        {
          "text": "Sie erschrickt, klar – wer würde das nicht?",
          "start_ms": 43240,
          "end_ms": 46680
        },
        {
          "text": "Aber der Engel, bevor er was erklärt",
          "start_ms": 46680,
          "end_ms": 49560
        },
        {
          "text": "Sagt erst mal das Wichtigste",
          "start_ms": 49560,
          "end_ms": 51800
        },
        {
          "text": "Das, was sie tragen muss, bevor der Rest kommt:",
          "start_ms": 51800,
          "end_ms": 55560
        }
      ],
      "start_ms": 29080,
      "end_ms": 55560
    },
    {
      "type": "bridge",
      "label": "Bridge",
      "lines": [
        {
          "text": "Zwei Menschen, zwei Momente",
          "start_ms": 58560,
          "end_ms": 60720
        },
        {
          "text": "Ein alter Mann, eine junge Frau",
          "start_ms": 60720,
          "end_ms": 63200
        },
        {
          "text": "Beide am Boden, beide erschüttert",
          "start_ms": 63200,
          "end_ms": 65840
        },
        {
          "text": "Und Gott? Gott fängt mit Trost an",
          "start_ms": 65840,
          "end_ms": 68480
        },
        {
          "text": "Nicht mit Forderung, nicht mit Plan",
          "start_ms": 68480,
          "end_ms": 71280
        },
        {
          "text": "Sondern: Ich seh dich, hab keine Angst",
          "start_ms": 71280,
          "end_ms": 74320
        },
        {
          "text": "Das ist sein Stil, das ist sein Herz",
          "start_ms": 74320,
          "end_ms": 77200
        },
        {
          "text": "Furcht ist nie sein erstes Wort",
          "start_ms": 77200,
          "end_ms": 79680
        }
      ],
      "start_ms": 58560,
      "end_ms": 79680
    },
    {
      "type": "outro",
      "label": "Outro",
      "lines": [
        {
          "text": "Keine Angst, keine Angst",
          "start_ms": 82680,
          "end_ms": 84680
        },
        {
          "text": "Was auch immer kommt",
          "start_ms": 84680,
          "end_ms": 86680
        },
        {
          "text": "Keine Angst, keine Angst",
          "start_ms": 86680,
          "end_ms": 88680
        },
        {
          "text": "Er fängt immer so an",
          "start_ms": 88680,
          "end_ms": 90680
        },
