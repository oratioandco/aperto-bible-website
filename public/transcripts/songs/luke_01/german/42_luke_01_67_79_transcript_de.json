      "lines": [
        {
          "text": "Neun Monate hab ich geschwiegen",
          "start_ms": 5000,
          "end_ms": 8919
        },
        {
          "text": "Neun Monate ohne ein Wort",
          "start_ms": 8919,
          "end_ms": 12838
        },
        {
          "text": "Ich konnte nicht beten, nicht segnen",
          "start_ms": 12838,
          "end_ms": 16757
        },
        {
          "text": "Nur warten an diesem stillen Ort",
          "start_ms": 16757,
          "end_ms": 20676
        },
        {
          "text": "Doch in der Stille hab ich gelernt",
          "start_ms": 20676,
          "end_ms": 24595
        },
        {
          "text": "Was Worte nie sagen konnten",
          "start_ms": 24595,
          "end_ms": 28514
        },
        {
          "text": "Dass Gott mich nicht vergessen hat",
          "start_ms": 28514,
          "end_ms": 32433
        },
        {
          "text": "Dass er sein Versprechen gehalten hat",
          "start_ms": 32433,
          "end_ms": 36353
