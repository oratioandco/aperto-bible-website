      "label": "Verse 1",
      "lines": [
        {
          "text": "Niemand hat mich auf dem Schirm gehabt",
          "start_ms": 10864,
          "end_ms": 13546
        },
        {
          "text": "Kleines Mädchen, kleines Dorf, keine Chance",
          "start_ms": 13546,
          "end_ms": 16228
        },
        {
          "text": "Die Welt sagt, du bist nichts, du bleibst nichts",
          "start_ms": 16228,
          "end_ms": 18910
        },
        {
          "text": "Aber dann kam einer, der hat mich gesehn",
          "start_ms": 18910,
          "end_ms": 21592
        },
        {
          "text": "Er hat mich gesehn, mich, die niemand sieht",
          "start_ms": 21592,
          "end_ms": 24274
        },
        {
          "text": "Er hat mich gehört, als niemand zuhört",
          "start_ms": 24274,
          "end_ms": 26956
        },
        {
          "text": "Er hat mich gewählt, obwohl ich niemand bin",
          "start_ms": 26956,
          "end_ms": 29638
        },
        {
          "text": "Und jetzt kann ich nicht still sein",
          "start_ms": 29638,
          "end_ms": 32321
