      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "text": "Neun Monate hab ich geschwiegen",
          "start_ms": 6000,
          "end_ms": 8480
        },
        {
          "text": "Neun Monate ohne ein Wort",
          "start_ms": 8480,
          "end_ms": 10480
        },
        {
          "text": "Ich konnte nicht beten, nicht segnen",
          "start_ms": 10480,
          "end_ms": 13360
        },
        {
          "text": "Nur warten an diesem stillen Ort",
          "start_ms": 13360,
          "end_ms": 15920
        },
        {
          "text": "Doch in der Stille hab ich gelernt",
          "start_ms": 15920,
          "end_ms": 18640
        },
        {
          "text": "Was Worte nie sagen konnten",
          "start_ms": 18640,
          "end_ms": 20800
        },
        {
          "text": "Dass Gott mich nicht vergessen hat",
          "start_ms": 20800,
          "end_ms": 23520
        },
        {
          "text": "Dass er sein Versprechen gehalten hat",
          "start_ms": 23520,
          "end_ms": 26480
        }
      ],
      "start_ms": 6000,
      "end_ms": 26480
    },
    {
      "type": "pre-chorus",
      "label": "Pre-Chorus",
      "lines": [
        {
          "text": "Und jetzt, jetzt öffnet sich mein Mund",
          "start_ms": 29480,
          "end_ms": 32520
        },
        {
          "text": "Und das erste Wort nach all der Zeit",
          "start_ms": 32520,
          "end_ms": 35400
        },
        {
          "text": "Ist nicht Klage, nicht mehr Angst",
          "start_ms": 35400,
          "end_ms": 38040
        }
      ],
      "start_ms": 29480,
      "end_ms": 38040
    },
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "text": "Sondern Dank",
          "start_ms": 41040,
          "end_ms": 43040
        },
        {
          "text": "Für den Weg des Friedens",
          "start_ms": 43040,
          "end_ms": 45040
        },
        {
          "text": "Für das Licht aus der Höhe",
          "start_ms": 45040,
          "end_ms": 47120
        },
        {
          "text": "Das zu uns kommt",
          "start_ms": 47120,
          "end_ms": 49120
        },
        {
          "text": "Weg des Friedens",
          "start_ms": 49120,
          "end_ms": 51120
        },
        {
          "text": "Ohne Furcht, ohne Angst",
          "start_ms": 51120,
          "end_ms": 53120
        },
        {
          "text": "Nicht mehr im Schatten",
          "start_ms": 53120,
          "end_ms": 55120
        },
        {
          "text": "Auf dem Weg des Friedens",
          "start_ms": 55120,
          "end_ms": 57120
        }
      ],
      "start_ms": 41040,
      "end_ms": 57120
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "text": "Und du, mein Kind",
          "start_ms": 60120,
          "end_ms": 62120
        },
        {
          "text": "Du liegst hier in meinem Arm",
          "start_ms": 62120,
          "end_ms": 64360
        },
        {
          "text": "So klein, so neu",
          "start_ms": 64360,
          "end_ms": 66360
        },
        {
          "text": "Du verstehst noch nicht, was ich dir sage",
          "start_ms": 66360,
          "end_ms": 69640
        },
        {
          "text": "Aber eines Tages wirst du wissen",
          "start_ms": 69640,
          "end_ms": 72200
        },
        {
          "text": "Dein Vater hat über dich gesprochen",
          "start_ms": 72200,
          "end_ms": 75000
        },
        {
          "text": "Hat dir Worte auf die Stirn gelegt",
          "start_ms": 75000,
          "end_ms": 77720
        },
        {
          "text": "Die größer sind als er",
          "start_ms": 77720,
          "end_ms": 79720
        }
      ],
