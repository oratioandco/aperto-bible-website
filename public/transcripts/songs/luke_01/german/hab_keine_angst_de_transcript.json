      "type": "verse",
      "label": "Verse 1",
      "lines": [
        {
          "text": "Kleines Zimmer, nichts Besondres",
          "start_ms": 6000,
          "end_ms": 8560
        },
        {
          "text": "Kleines Leben, kleines Dorf",
          "start_ms": 8560,
          "end_ms": 10720
        },
        {
          "text": "Und dann plötzlich diese Worte",
          "start_ms": 10720,
          "end_ms": 13120
        },
        {
          "text": "Die mich treffen wie ein Sturm",
          "start_ms": 13120,
          "end_ms": 15520
        },
        {
          "text": "Alles bebt, ich kann nicht atmen",
          "start_ms": 15520,
          "end_ms": 18080
        },
        {
          "text": "Was passiert hier, wer bist du",
          "start_ms": 18080,
          "end_ms": 20480
        },
        {
          "text": "Meine Hände zittern, mein Herz rast",
          "start_ms": 20480,
          "end_ms": 23280
        },
        {
          "text": "Und ich weiß nicht mehr wozu",
          "start_ms": 23280,
          "end_ms": 25520
        }
      ],
      "start_ms": 6000,
      "end_ms": 25520
    },
    {
