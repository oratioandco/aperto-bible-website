        {
          "text": "Mein Ruf, vielleicht mein Leben",
          "start_ms": 71320,
          "end_ms": 73800
        },
        {
          "text": "Und ich soll einfach Ja sagen",
          "start_ms": 73800,
          "end_ms": 76120
