        {
          "text": "nieco, co uz nejde zastavit",
          "start_ms": 13360,
          "end_ms": 15520
        },
        {
          "text": "Oni si myslia, ze vsetko je po starom",
          "start_ms": 15520,
          "end_ms": 18480
        },
        {
          "text": "oni si myslia, ze sa nic nemeni",
