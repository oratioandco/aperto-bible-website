    },
    {
      "type": "pre-chorus",
      "label": "Pre-Chorus",
      "lines": [
        {
          "text": "Nebola som nic a nikto sa nepytal",
          "start_ms": 28040,
          "end_ms": 30680
        },
        {
          "text": "ale ten, co videl odo zaciatku",
