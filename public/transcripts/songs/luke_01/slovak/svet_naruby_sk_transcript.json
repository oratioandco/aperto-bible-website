      "end_ms": 35080
    },
    {
      "type": "chorus",
      "label": "Chorus",
      "lines": [
        {
          "text": "A ja hovorim, svet naruby",
          "start_ms": 38080,
          "end_ms": 40080
        },
        {
          "text": "to, co bolo hore, lezi dolu",
          "start_ms": 40080,
