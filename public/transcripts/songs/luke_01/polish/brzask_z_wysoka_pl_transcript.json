        {
          "text": "Pierwsze słowa nie o sobie",
          "start_ms": 22720,
          "end_ms": 24800
        },
        {
          "text": "Ale o tobie, o nas, o tych",
          "start_ms": 24800,
          "end_ms": 26880
        }
      ],
      "start_ms": 6000,
      "end_ms": 26880
    },
    {
      "type": "pre-chorus",
      "label": "Pre-Chorus",
      "lines": [
