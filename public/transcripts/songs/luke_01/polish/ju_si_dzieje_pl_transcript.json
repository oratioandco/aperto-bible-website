      "label": "Verse 1",
      "lines": [
        {
          "text": "Dziewczyna z Nazaretu, siedemnaście lat",
          "start_ms": 6000,
          "end_ms": 9120
        },
        {
          "text": "Wybrała ją, nie kapłana, nie filozofa",
          "start_ms": 9120,
          "end_ms": 12080
        },
        {
          "text": "Pyta po co, nie dlaczego, rozumie ciężar",
          "start_ms": 12080,
          "end_ms": 15280
        },
        {
          "text": "Mówi tak w momencie, kiedy nie ma gwarancji",
          "start_ms": 15280,
          "end_ms": 18720
        },
        {
          "text": "Józef może odejść, wioska może odrzucić",
          "start_ms": 18720,
          "end_ms": 21840
        },
        {
          "text": "Ale ona mówi: należę do Pana",
          "start_ms": 21840,
          "end_ms": 24080
        },
        {
          "text": "I zanim cokolwiek się wydarzy",
          "start_ms": 24080,
          "end_ms": 26400
        },
        {
          "text": "Śpiewa o tym, co już jest pewne",
          "start_ms": 26400,
          "end_ms": 28880
        }
      ],
      "start_ms": 6000,
      "end_ms": 28880
    },
    {
      "type": "verse",
      "label": "Hook",
      "lines": [
        {
          "text": "Władców strąca z tronów",
          "start_ms": 31880,
          "end_ms": 33880
        },
        {
          "text": "Poniżonych podnosi",
          "start_ms": 33880,
          "end_ms": 35880
        },
        {
          "text": "To nie jutro, to teraz",
          "start_ms": 35880,
          "end_ms": 37880
