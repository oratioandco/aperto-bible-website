        {
          "text": "Bogatych odprawia",
          "start_ms": 39880,
          "end_ms": 41880
        },
        {
          "text": "Już się dzieje",
          "start_ms": 41880,
          "end_ms": 43880
        }
      ],
      "start_ms": 31880,
